{
  "properties": {
    "iconBrandColor": "#007EE6",
    "connectionParameterSets": {
      "uiDefinition": {
        "displayName": "Authentication Type",
        "description": "Type of authentication to be used."
      },
      "values": [
        {
          "name": "basic-auth",
          "uiDefinition": {
            "displayName": "Basic authentication",
            "description": "Sign in with your username and password."
          },
          "parameters": {
            "username": {
              "type": "string",
              "uiDefinition": {
                "displayName": "Username",
                "schema": {
                  "description": "Your username",
                  "type": "string"
                },
                "tooltip": "Provide your username",
                "constraints": {
                  "required": "true"
                }
              }
            },
            "password": {
              "type": "securestring",
              "uiDefinition": {
                "displayName": "Password",
                "schema": {
                  "description": "Your password",
                  "type": "securestring"
                },
                "constraints": {
                  "required": "true"
                }
              }
            }
          }
        },
        {
          "name": "api-auth",
          "uiDefinition": {
            "displayName": "API key",
            "description": "Sign in with your API key."
          },
          "parameters": {
            "api_key": {
              "type": "securestring",
              "uiDefinition": {
                "displayName": "API key",
                "schema": {
                  "description": "Enter your API key",
                  "type": "securestring"
                },
                "constraints": {
                  "clearText": false,
                  "required": "true",
                  "tabIndex": 3
                }
              }
            },
            "environment": {
              "type": "string",
              "uiDefinition": {
                "displayName": "Environment",
                "schema": {
                  "description": "The API environment to use",
                  "type": "string"
                },
                "constraints": {
                  "required": "true",
                  "allowedValues": [
                    {"text": "Sandbox", "value": "sandbox"},
                    {"text": "Production", "value": "production"}
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
