{
  "properties": {
    "iconBrandColor": "#007EE6",
    "connectionParameterSets": {
      "uiDefinition": {
        "displayName": "Authentication Type",
        "description": "Type of authentication to be used."
      },
      "values": [
        {
          "name": "aad-auth",
          "uiDefinition": {
            "displayName": "Shared application",
            "description": "Sign in with the shared application."
          },
          "parameters": {
            "token": {
              "type": "oauthSetting",
              "oAuthSettings": {
                "clientId": "YOUR_AAD_APPLICATION_ID_HERE",
                "identityProvider": "aad",
                "redirectMode": "GlobalPerConnector",
                "customParameters": {
                  "loginUri": {"value": "https://login.windows.net"},
                  "resourceUri": {"value": "https://graph.microsoft.com"},
                  "tenantId": {"value": "common"}
                },
                "properties": {"IsFirstParty": "False"},
                "scopes": ["Group.ReadWrite.All offline_access"]
              },
              "uiDefinition": {
                "displayName": "Entra ID authentication",
                "description": "Sign in with Entra ID.",
                "tooltip": "Entra ID authentication",
                "constraints": {"required": "true"}
              }
            }
          }
        },
        {
          "name": "custom-app-auth",
          "uiDefinition": {
            "displayName": "Custom application",
            "description": "Sign in with a custom application."
          },
          "parameters": {
            "token": {
              "type": "oauthSetting",
              "oAuthSettings": {
                "clientId": "YOUR_CLIENT_ID_HERE",
                "identityProvider": "oauth2",
                "redirectMode": "GlobalPerConnector",
                "customParameters": {
                  "authorizationUrl": {"value": "https://login.example.com/authorize"},
                  "refreshUrl": {"value": "https://login.example.com/token"},
                  "tokenUrl": {"value": "https://login.example.com/token"}
                }
              },
              "uiDefinition": {
                "displayName": "Custom application authentication",
                "description": "Sign in with your custom application.",
                "tooltip": "Custom application authentication",
                "constraints": {"required": "true"}
              }
            },
            "token:clientId": {
              "type": "string",
              "uiDefinition": {
                "schema": {
                  "type": "string",
                  "description": "The client ID of your application"
                },
                "displayName": "Client ID",
                "constraints": {"required": "true"}
              }
            }
          }
        }
      ]
    }
  }
}
