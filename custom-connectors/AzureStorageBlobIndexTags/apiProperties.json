{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "aad",
          "clientId": "YOUR_CLIENT_ID",
          "scopes": [
            "https://storage.azure.com/.default"
          ],
          "redirectMode": "Global",
          "redirectUrl": "https://global.consent.azure-apim.net/redirect",
          "properties": {
            "IsFirstParty": "False",
            "AzureActiveDirectoryResourceId": "https://storage.azure.com"
          },
          "customParameters": {
            "loginUri": {
              "value": "https://login.windows.net"
            },
            "tenantId": {
              "value": "common"
            },
            "resourceUri": {
              "value": "https://storage.azure.com"
            }
          }
        }
      },
      "storageAccountName": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Storage Account Name",
          "description": "The name of your Azure Storage Account (e.g., 'mystorageaccount')",
          "tooltip": "Enter your storage account name without '.blob.core.windows.net'",
          "constraints": {
            "tabIndex": 2,
            "required": "true"
          }
        }
      }
    },
    "iconBrandColor": "#0078D4",
    "capabilities": [],
    "publisher": "Power Platform Community",
    "stackOwner": "Microsoft Azure",
    "policyTemplateInstances": [
      {
        "templateId": "setheader",
        "title": "Set Host Header",
        "parameters": {
          "x-ms-apimTemplateParameter.name": "Host",
          "x-ms-apimTemplateParameter.value": "@connectionParameters('storageAccountName').blob.core.windows.net",
          "x-ms-apimTemplateParameter.existsAction": "override",
          "x-ms-apimTemplate-policySection": "Request"
        }
      },
      {
        "templateId": "dynamichosturl",
        "title": "Set Dynamic Host URL",
        "parameters": {
          "x-ms-apimTemplateParameter.urlTemplate": "https://@connectionParameters('storageAccountName').blob.core.windows.net"
        }
      }
    ]
  }
}
