{
  "name": "PlumoAi",
  "version": "1.0.0",
  "description": "Easily connect Power BI with PlumoAi and access Workspaces, Projects, Tables, and Records using OAuth2.",
  "publisher": "Independent Publisher",
  "icon": "PlumoAi32.png",
  "authentication": {
    "type": "OAuth2",
