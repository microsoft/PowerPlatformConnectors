    "scopes": [
      "read",
      "write",
      "offline_access"
    ],
    "redirectUrl": "https://oauth.powerbi.com/views/oauthredirect.html"
  },
  "apiBaseUrl": "https://api.plumoai.com/v1",
  "capabilities": [
    "Read",
    "Navigation"
  ],
  "beta": true,
  "category": "Online Services",
  "learnMoreUrl": "https://plumoai.com"
}
