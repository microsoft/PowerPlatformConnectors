{
  "swagger": "2.0",
  "info": {
    "title": "ExchangeRate-API",
    "description": "A reliable and easy-to-use currency conversion API providing exchange rates for 161+ currencies. Get latest rates, convert between currency pairs, access historical data, and more. Get your free API key at https://app.exchangerate-api.com/sign-up",
    "version": "6.0",
    "contact": {
      "name": "ExchangeRate-API Support",
      "url": "https://www.exchangerate-api.com",
      "email": "support@exchangerate-api.com"
    },
    "x-ms-api-annotation": {
      "status": "Production"
    }
  },
  "host": "v6.exchangerate-api.com",
  "basePath": "/v6",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/{api-key}/latest/{base_code}": {
      "get": {
        "operationId": "GetLatestRates",
        "summary": "Get Latest Exchange Rates",
        "description": "Returns the latest exchange rates from your base currency to all supported currencies.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "api-key",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Your API key from ExchangeRate-API dashboard",
            "x-ms-summary": "API Key",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "base_code",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Base currency code (ISO 4217, e.g., USD, EUR, GBP)",
            "x-ms-summary": "Base Currency Code",
            "x-ms-url-encoding": "single"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with exchange rates",
            "schema": {
              "$ref": "#/definitions/LatestRatesResponse"
            }
          },
          "default": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/{api-key}/pair/{base_code}/{target_code}": {
      "get": {
        "operationId": "GetPairConversion",
        "summary": "Get Pair Conversion Rate",
        "description": "Returns the exchange rate between two specific currencies.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "api-key",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Your API key from ExchangeRate-API dashboard",
            "x-ms-summary": "API Key",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "base_code",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Base currency code (ISO 4217, e.g., EUR)",
            "x-ms-summary": "Base Currency Code",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "target_code",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Target currency code (ISO 4217, e.g., GBP)",
            "x-ms-summary": "Target Currency Code",
            "x-ms-url-encoding": "single"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with conversion rate",
            "schema": {
              "$ref": "#/definitions/PairConversionResponse"
            }
          },
          "default": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/{api-key}/pair/{base_code}/{target_code}/{amount}": {
      "get": {
        "operationId": "ConvertAmount",
        "summary": "Convert Currency Amount",
        "description": "Converts a specific amount from one currency to another.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "api-key",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Your API key from ExchangeRate-API dashboard",
            "x-ms-summary": "API Key",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "base_code",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Base currency code (ISO 4217, e.g., EUR)",
            "x-ms-summary": "Base Currency Code",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "target_code",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Target currency code (ISO 4217, e.g., GBP)",
            "x-ms-summary": "Target Currency Code",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "amount",
            "in": "path",
            "required": true,
            "type": "number",
            "format": "double",
            "description": "Amount to convert (decimal format)",
            "x-ms-summary": "Amount",
            "x-ms-url-encoding": "single"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with conversion result",
            "schema": {
              "$ref": "#/definitions/AmountConversionResponse"
            }
          },
          "default": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/{api-key}/enriched/{base_code}/{target_code}": {
      "get": {
        "operationId": "GetEnrichedData",
        "summary": "Get Enriched Currency Data",
        "description": "Returns exchange rate plus additional data including currency name, symbol, country, and flag URL. Requires Business or Volume plan.",
        "x-ms-visibility": "advanced",
        "parameters": [
          {
            "name": "api-key",
            "in": "path",
            "required": true,
            "type": "string",
