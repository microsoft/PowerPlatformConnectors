            "x-ms-summary": "API Key",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "base_code",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Base currency code (ISO 4217, e.g., GBP)",
            "x-ms-summary": "Base Currency Code",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "target_code",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Target currency code (ISO 4217, e.g., JPY)",
            "x-ms-summary": "Target Currency Code",
            "x-ms-url-encoding": "single"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with enriched data",
            "schema": {
              "$ref": "#/definitions/EnrichedDataResponse"
            }
          },
          "default": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/{api-key}/history/{base_code}/{year}/{month}/{day}": {
      "get": {
        "operationId": "GetHistoricalRates",
        "summary": "Get Historical Exchange Rates",
        "description": "Returns exchange rates for a specific historical date. Requires Pro, Business, or Volume plan. Data available from 1990 for major currencies, full coverage from 2021.",
        "x-ms-visibility": "advanced",
        "parameters": [
          {
            "name": "api-key",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Your API key from ExchangeRate-API dashboard",
            "x-ms-summary": "API Key",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "base_code",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Base currency code (ISO 4217, e.g., USD)",
            "x-ms-summary": "Base Currency Code",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Year (e.g., 2023)",
            "x-ms-summary": "Year",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Month (1-12, no leading zeros)",
            "x-ms-summary": "Month",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "day",
            "in": "path",
            "required": true,
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "description": "Day (1-31, no leading zeros)",
            "x-ms-summary": "Day",
            "x-ms-url-encoding": "single"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with historical rates",
            "schema": {
              "$ref": "#/definitions/HistoricalRatesResponse"
            }
          },
          "default": {
            "description": "Error response",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
