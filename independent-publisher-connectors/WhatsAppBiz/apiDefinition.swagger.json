{
  "swagger": "2.0",
  "info": {
    "title": "WhatsApp Business",
    "description": "Connect to WhatsApp Business Cloud API to send messages, manage templates, and engage with customers via WhatsApp. This connector enables businesses to send text messages, media, templates, and interactive messages through the WhatsApp Business Platform.",
    "version": "1.0.0",
    "contact": {
      "name": "Your Name",
      "url": "https://github.com/yourusername",
      "email": "your.email@example.com"
    }
  },
  "host": "graph.facebook.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "apiKey": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/v21.0/{phoneNumberId}/messages": {
      "post": {
        "summary": "Send Text Message",
        "description": "Send a text message to a WhatsApp user. Can only be used within the 24-hour customer service window unless using a template.",
        "operationId": "SendTextMessage",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "phoneNumberId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Your WhatsApp Business Phone Number ID",
            "x-ms-summary": "Phone Number ID",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "messaging_product",
                "recipient_type",
                "to",
                "type",
                "text"
              ],
              "properties": {
                "messaging_product": {
                  "type": "string",
                  "default": "whatsapp",
                  "description": "Messaging product (always 'whatsapp')",
                  "x-ms-summary": "Messaging Product",
                  "x-ms-visibility": "internal"
                },
                "recipient_type": {
                  "type": "string",
                  "default": "individual",
                  "description": "Type of recipient",
                  "x-ms-summary": "Recipient Type",
                  "x-ms-visibility": "internal"
                },
                "to": {
                  "type": "string",
                  "description": "Recipient phone number with country code (e.g., 14155238886)",
                  "x-ms-summary": "To Phone Number"
                },
                "type": {
                  "type": "string",
                  "default": "text",
                  "description": "Message type",
                  "x-ms-summary": "Message Type",
                  "x-ms-visibility": "internal"
                },
                "text": {
                  "type": "object",
                  "properties": {
                    "preview_url": {
                      "type": "boolean",
                      "default": false,
                      "description": "Enable URL preview in the message",
                      "x-ms-summary": "Enable URL Preview"
                    },
                    "body": {
                      "type": "string",
                      "description": "The text message content",
                      "x-ms-summary": "Message Body"
                    }
                  },
                  "required": [
                    "body"
                  ]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Message sent successfully",
            "schema": {
              "$ref": "#/definitions/MessageResponse"
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "x-ms-visibility": "important"
      }
    },
    "/v21.0/{phoneNumberId}/messages/template": {
      "post": {
        "summary": "Send Template Message",
        "description": "Send a pre-approved template message. Templates can be sent anytime, even outside the 24-hour customer service window.",
        "operationId": "SendTemplateMessage",
        "parameters": [
          {
            "name": "phoneNumberId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Your WhatsApp Business Phone Number ID",
            "x-ms-summary": "Phone Number ID",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "messaging_product",
                "to",
                "type",
                "template"
              ],
              "properties": {
                "messaging_product": {
                  "type": "string",
                  "default": "whatsapp",
                  "x-ms-visibility": "internal"
                },
                "to": {
                  "type": "string",
                  "description": "Recipient phone number with country code",
                  "x-ms-summary": "To Phone Number"
                },
                "type": {
                  "type": "string",
                  "default": "template",
                  "x-ms-visibility": "internal"
                },
                "template": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Name of the approved template",
                      "x-ms-summary": "Template Name"
                    },
                    "language": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Language code (e.g., en_US, es_ES)",
                          "x-ms-summary": "Language Code",
                          "default": "en_US"
                        }
                      },
                      "required": [
                        "code"
                      ]
                    },
                    "components": {
                      "type": "array",
                      "description": "Template components with parameters",
                      "x-ms-summary": "Components",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "description": "Component type (header, body, button)"
                          },
                          "parameters": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "name",
                    "language"
                  ]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Template message sent successfully",
            "schema": {
              "$ref": "#/definitions/MessageResponse"
            }
          }
        }
      }
    },
