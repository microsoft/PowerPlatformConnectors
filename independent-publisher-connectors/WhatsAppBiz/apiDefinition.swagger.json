    "/v21.0/{phoneNumberId}/messages/interactive": {
      "post": {
        "summary": "Send Interactive Button Message",
        "description": "Send an interactive message with reply buttons (up to 3 buttons).",
        "operationId": "SendInteractiveButtonMessage",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "phoneNumberId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Your WhatsApp Business Phone Number ID",
            "x-ms-summary": "Phone Number ID",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "messaging_product",
                "to",
                "type",
                "interactive"
              ],
              "properties": {
                "messaging_product": {
                  "type": "string",
                  "default": "whatsapp",
                  "x-ms-visibility": "internal"
                },
                "to": {
                  "type": "string",
                  "description": "Recipient phone number with country code",
                  "x-ms-summary": "To Phone Number"
                },
                "type": {
                  "type": "string",
                  "default": "interactive",
                  "x-ms-visibility": "internal"
                },
                "interactive": {
                  "type": "object",
                  "required": [
                    "type",
                    "body",
                    "action"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "default": "button",
                      "x-ms-visibility": "internal"
                    },
                    "body": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
