        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "tool"
              ],
              "properties": {
                "tool": {
                  "type": "string",
                  "description": "The tool id returned by Discover tools, for example 1toolring/fx/latest.",
                  "title": "Tool ID",
                  "x-ms-visibility": "important"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The tool id to pass to Inspect tool and Run tool.",
                      "title": "Tool ID"
                    },
                    "provider": {
                      "type": "string",
                      "description": "The provider id.",
                      "title": "Provider"
                    },
                    "provider_name": {
                      "type": "string",
                      "description": "The provider display name.",
                      "title": "Provider name"
                    },
                    "endpoint": {
                      "type": "string",
                      "description": "The provider endpoint the tool calls.",
                      "title": "Endpoint"
                    },
                    "description": {
                      "type": "string",
                      "description": "What the tool does.",
                      "title": "Description"
                    },
                    "price": {
                      "type": "object",
                      "description": "The price of the tool.",
                      "properties": {
                        "model": {
                          "type": "string",
                          "description": "Pricing model: per_call, per_result, per_unit, tiered or free.",
                          "title": "Price model"
                        },
                        "amount": {
                          "type": "object",
                          "description": "The price of one call, result or unit.",
                          "properties": {
                            "usd": {
                              "type": "number",
                              "format": "double",
                              "description": "Amount in US dollars.",
                              "title": "USD"
                            },
                            "idr": {
                              "type": "integer",
                              "format": "int64",
                              "description": "Amount in whole rupiah.",
                              "title": "IDR"
                            }
                          },
                          "title": "Amount"
                        },
                        "unit_label": {
                          "type": "string",
                          "description": "What one unit is, when the model is per unit or per result.",
                          "title": "Unit label"
                        },
                        "flat": {
                          "type": "object",
                          "description": "A fixed fee per run on top of the unit price, when the tool has one.",
                          "properties": {
                            "usd": {
                              "type": "number",
                              "format": "double",
                              "description": "Amount in US dollars.",
                              "title": "USD"
                            },
                            "idr": {
                              "type": "integer",
                              "format": "int64",
                              "description": "Amount in whole rupiah.",
                              "title": "IDR"
                            }
                          },
                          "title": "Flat fee"
                        }
                      }
                    },
                    "summary": {
                      "type": "string",
                      "description": "A short summary of what the tool returns.",
                      "title": "Summary"
                    },
                    "method": {
                      "type": "string",
                      "description": "The HTTP method of the provider endpoint.",
                      "title": "Method"
                    },
                    "input_schema": {
                      "type": "object",
                      "description": "The JSON schemas for the body, query and path inputs of the tool.",
                      "title": "Input schema",
                      "properties": {
                        "body": {
                          "type": "object",
                          "description": "JSON schema of the request body.",
                          "title": "Body schema"
                        },
                        "queryParams": {
                          "type": "object",
                          "description": "JSON schema of the query parameters.",
                          "title": "Query parameters schema"
                        },
                        "pathParams": {
                          "type": "object",
                          "description": "JSON schema of the path parameters.",
                          "title": "Path parameters schema"
                        }
                      }
                    },
                    "notes": {
                      "type": "array",
                      "description": "Notes about using the tool.",
                      "items": {
                        "type": "string"
                      }
                    },
                    "categories": {
                      "type": "array",
                      "description": "Catalog categories of the tool.",
                      "items": {
                        "type": "string"
                      }
                    },
                    "tags": {
                      "type": "array",
                      "description": "Tags of the tool.",
                      "items": {
                        "type": "string"
                      }
                    },
                    "doc_url": {
                      "type": "string",
                      "description": "Link to the provider documentation.",
                      "title": "Documentation URL"
                    },
                    "health": {
                      "type": "object",
                      "description": "Recent health of the tool.",
                      "title": "Health",
                      "properties": {
                        "status": {
                          "type": "string",
                          "description": "Health status.",
                          "title": "Health status"
                        },
                        "p50_ms": {
                          "type": "integer",
                          "format": "int32",
                          "description": "Median latency in milliseconds.",
                          "title": "Median latency"
                        },
                        "p95_ms": {
                          "type": "integer",
                          "format": "int32",
                          "description": "95th percentile latency in milliseconds.",
                          "title": "P95 latency"
                        }
                      }
                    }
