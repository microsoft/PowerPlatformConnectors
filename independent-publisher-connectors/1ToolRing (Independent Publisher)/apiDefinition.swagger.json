    "/api/v1/tools/run": {
      "post": {
        "operationId": "RunTool",
        "summary": "Run tool",
        "description": "Run a tool with its inputs. The run is charged at the price shown by Inspect tool, and a failed run is not charged.",
        "x-ms-visibility": "important",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "tool",
                "input"
              ],
              "properties": {
                "tool": {
                  "type": "string",
                  "description": "The tool id to run.",
                  "title": "Tool ID",
                  "x-ms-visibility": "important"
                },
                "input": {
                  "type": "object",
                  "description": "The tool inputs, shaped by the input schema from Inspect tool.",
                  "title": "Input",
                  "x-ms-visibility": "important",
                  "properties": {
                    "body": {
                      "type": "object",
                      "description": "The JSON body for the tool, when its input schema declares one.",
                      "title": "Body"
                    },
                    "queryParams": {
                      "type": "object",
                      "description": "The query parameters for the tool, when its input schema declares them.",
                      "title": "Query parameters"
                    },
                    "pathParams": {
                      "type": "object",
                      "description": "The path parameters for the tool, when its input schema declares them.",
                      "title": "Path parameters"
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The run finished.",
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "run_id": {
                      "type": "string",
                      "description": "The run id.",
                      "title": "Run ID"
                    },
                    "tool": {
                      "type": "string",
                      "description": "The tool id that ran.",
                      "title": "Tool"
                    },
                    "status": {
                      "type": "string",
                      "description": "The run status: running, completed or failed.",
                      "title": "Status"
                    },
                    "output": {
                      "description": "The answer from the tool, passed through as is. Its shape depends on the tool.",
                      "title": "Output"
                    },
                    "provider_status": {
                      "type": "integer",
                      "format": "int32",
                      "description": "The HTTP status the provider returned.",
                      "title": "Provider status"
                    },
                    "provider_error": {
                      "type": "string",
                      "description": "A short reason when the provider failed.",
                      "title": "Provider error"
                    },
                    "cost": {
                      "type": "object",
                      "description": "The amount actually charged. It is zero while running and on failure.",
                      "properties": {
                        "usd": {
                          "type": "number",
                          "format": "double",
                          "description": "Amount in US dollars.",
                          "title": "USD"
                        },
                        "idr": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Amount in whole rupiah.",
                          "title": "IDR"
                        }
                      },
                      "title": "Cost"
                    },
                    "held": {
                      "type": "object",
                      "description": "The amount held while the run is in flight.",
                      "properties": {
                        "usd": {
                          "type": "number",
                          "format": "double",
                          "description": "Amount in US dollars.",
                          "title": "USD"
                        },
                        "idr": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Amount in whole rupiah.",
                          "title": "IDR"
                        }
                      },
                      "title": "Held"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the run started.",
                      "title": "Created at"
                    },
                    "completed_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the run finished.",
                      "title": "Completed at"
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "The run is still running. Poll it with Get tool run.",
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "run_id": {
                      "type": "string",
                      "description": "The run id.",
                      "title": "Run ID"
                    },
                    "tool": {
                      "type": "string",
                      "description": "The tool id that ran.",
                      "title": "Tool"
                    },
                    "status": {
                      "type": "string",
                      "description": "The run status: running, completed or failed.",
                      "title": "Status"
                    },
                    "output": {
                      "description": "The answer from the tool, passed through as is. Its shape depends on the tool.",
                      "title": "Output"
                    },
                    "provider_status": {
                      "type": "integer",
                      "format": "int32",
                      "description": "The HTTP status the provider returned.",
                      "title": "Provider status"
                    },
                    "provider_error": {
                      "type": "string",
                      "description": "A short reason when the provider failed.",
                      "title": "Provider error"
                    },
                    "cost": {
                      "type": "object",
                      "description": "The amount actually charged. It is zero while running and on failure.",
                      "properties": {
                        "usd": {
                          "type": "number",
                          "format": "double",
                          "description": "Amount in US dollars.",
                          "title": "USD"
                        },
                        "idr": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Amount in whole rupiah.",
                          "title": "IDR"
                        }
                      },
                      "title": "Cost"
                    },
                    "held": {
                      "type": "object",
                      "description": "The amount held while the run is in flight.",
                      "properties": {
                        "usd": {
                          "type": "number",
                          "format": "double",
                          "description": "Amount in US dollars.",
                          "title": "USD"
                        },
                        "idr": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Amount in whole rupiah.",
                          "title": "IDR"
                        }
                      },
                      "title": "Held"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the run started.",
                      "title": "Created at"
                    },
                    "completed_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the run finished.",
                      "title": "Completed at"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/runs/{run_id}": {
