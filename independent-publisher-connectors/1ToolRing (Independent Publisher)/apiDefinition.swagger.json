{
  "swagger": "2.0",
  "info": {
    "title": "1ToolRing",
    "description": "1ToolRing is a pay per call tool catalog for AI agents and flows. Find a tool for a job, read its exact price, run it with one key and one prepaid balance, and see what each run cost. Failed runs are not charged.",
    "contact": {
      "name": "Khairul Muhtadin",
      "url": "https://1toolring.com",
      "email": "hello@1toolring.com"
    },
    "version": "1.0"
  },
  "host": "api.1toolring.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/tools/discover": {
      "post": {
        "operationId": "DiscoverTools",
        "summary": "Discover tools",
        "description": "Find tools for a job described in plain words, with their ids and prices. This call is free.",
        "x-ms-visibility": "important",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "query"
              ],
              "properties": {
                "query": {
                  "type": "string",
                  "description": "The job to do, in plain words, for example google search results for a keyword.",
                  "title": "Query",
                  "x-ms-visibility": "important"
                },
                "limit": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1,
                  "maximum": 20,
                  "default": 10,
                  "description": "How many tools to return, from 1 to 20.",
                  "title": "Limit"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string",
                      "description": "The query that was searched.",
                      "title": "Query"
                    },
                    "count": {
                      "type": "integer",
                      "format": "int32",
                      "description": "How many tools were found.",
                      "title": "Count"
                    },
                    "results": {
                      "type": "array",
                      "description": "The matching tools.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "The tool id to pass to Inspect tool and Run tool.",
                            "title": "Tool ID"
                          },
                          "provider": {
                            "type": "string",
                            "description": "The provider id.",
                            "title": "Provider"
                          },
                          "provider_name": {
                            "type": "string",
                            "description": "The provider display name.",
                            "title": "Provider name"
                          },
                          "endpoint": {
                            "type": "string",
                            "description": "The provider endpoint the tool calls.",
                            "title": "Endpoint"
                          },
                          "description": {
                            "type": "string",
                            "description": "What the tool does.",
                            "title": "Description"
                          },
                          "price": {
                            "type": "object",
                            "description": "The price of the tool.",
                            "properties": {
                              "model": {
                                "type": "string",
                                "description": "Pricing model: per_call, per_result, per_unit, tiered or free.",
                                "title": "Price model"
                              },
                              "amount": {
                                "type": "object",
                                "description": "The price of one call, result or unit.",
                                "properties": {
                                  "usd": {
                                    "type": "number",
                                    "format": "double",
                                    "description": "Amount in US dollars.",
                                    "title": "USD"
                                  },
                                  "idr": {
                                    "type": "integer",
                                    "format": "int64",
                                    "description": "Amount in whole rupiah.",
                                    "title": "IDR"
                                  }
                                },
                                "title": "Amount"
                              },
                              "unit_label": {
                                "type": "string",
                                "description": "What one unit is, when the model is per unit or per result.",
                                "title": "Unit label"
                              },
                              "flat": {
                                "type": "object",
                                "description": "A fixed fee per run on top of the unit price, when the tool has one.",
                                "properties": {
                                  "usd": {
                                    "type": "number",
                                    "format": "double",
                                    "description": "Amount in US dollars.",
                                    "title": "USD"
                                  },
                                  "idr": {
                                    "type": "integer",
                                    "format": "int64",
                                    "description": "Amount in whole rupiah.",
                                    "title": "IDR"
                                  }
                                },
                                "title": "Flat fee"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/inspect": {
      "post": {
        "operationId": "InspectTool",
        "summary": "Inspect tool",
        "description": "Read the input schema, exact price, notes and health of one tool before running it. This call is free.",
