{
  "swagger": "2.0",
  "info": {
    "title": "LINE WORKS Incoming Webhook (Independent Publisher)",
    "description": "LINE WORKS is a business chat and collaboration service. Use this connector to post notification messages, with an optional link button, to LINE WORKS talk rooms through the Incoming Webhook app.",
    "version": "1.0.0",
    "contact": {
      "name": "iwaohig",
      "url": "https://github.com/iwaohig",
      "email": "iwaohig@gmail.com"
    }
  },
  "host": "webhook.worksmobile.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/message/{webhookId}": {
      "post": {
        "summary": "Send message",
        "description": "Sends a message to the LINE WORKS talk room that is linked to the specified Incoming Webhook URL.",
        "operationId": "SendMessage",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "webhookId",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Webhook ID",
            "x-ms-visibility": "important",
            "description": "The ID at the end of the Incoming Webhook URL, after https://webhook.worksmobile.com/message/."
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "body"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "title": "Title",
                  "x-ms-summary": "Title",
                  "x-ms-visibility": "important",
                  "description": "The message title. If it is empty, the title set for the webhook in LINE WORKS is used."
                },
                "body": {
                  "type": "object",
                  "x-ms-summary": "Body",
                  "description": "The message body.",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "title": "Message Text",
                      "x-ms-summary": "Message Text",
                      "x-ms-visibility": "important",
                      "description": "The message text. To mention a member, use <m userId=\"user@example.com\">."
                    }
                  }
                },
                "button": {
                  "type": "object",
                  "x-ms-summary": "Button",
                  "description": "An optional link button. Set both the label and the URL to show the button.",
                  "required": [
                    "label",
                    "url"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "title": "Button Label",
                      "x-ms-summary": "Button Label",
                      "x-ms-visibility": "advanced",
                      "description": "The text shown on the link button."
                    },
                    "url": {
                      "type": "string",
                      "title": "Button URL",
                      "x-ms-summary": "Button URL",
                      "x-ms-visibility": "advanced",
                      "description": "The URL that opens when the link button is selected."
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The message was sent.",
            "schema": {
              "$ref": "#/definitions/SendMessageResponse"
            }
          },
          "400": {
            "description": "A parameter is missing or invalid, or the webhook URL is invalid."
          },
          "429": {
            "description": "Too many requests were sent. The limit is 120 requests per minute per LINE WORKS domain."
          }
        }
      }
    }
  },
  "definitions": {
    "SendMessageResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32",
          "title": "Code",
          "x-ms-summary": "Code",
          "description": "The result code. The value is 200 when the message is sent."
        },
        "description": {
          "type": "string",
          "title": "Description",
          "x-ms-summary": "Description",
          "description": "The result description, such as success."
        }
      }
    }
  },
  "parameters": {},
  "responses": {},
  "securityDefinitions": {},
  "security": [],
  "tags": [],
  "x-ms-connector-metadata": [
    {
      "propertyName": "Website",
      "propertyValue": "https://line-works.com/"
    },
    {
      "propertyName": "Privacy policy",
      "propertyValue": "https://line-works.com/privacy/"
    },
    {
      "propertyName": "Categories",
      "propertyValue": "Communication;Collaboration"
    }
  ]
}
