{
  "swagger": "2.0",
  "info": {
    "title": "apolloenrichment2",
    "description": "Power Automate custom connector for Apollo.io enrichment APIs.",
    "version": "1.0.0"
  },
  "host": "api.apollo.io",
  "basePath": "/api/v1",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/people/match": {
      "post": {
        "summary": "Enrich a single person",
        "operationId": "enrichPerson",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "first_name": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                },
                "organization_name": {
                  "type": "string"
                },
                "domain": {
                  "type": "string"
                },
                "reveal_personal_emails": {
                  "type": "boolean"
                },
                "reveal_phone_numbers": {
                  "type": "boolean"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Person enrichment result",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/people/bulk_match": {
      "post": {
        "summary": "Enrich multiple people (up to 10)",
        "operationId": "bulkEnrichPeople",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "queries": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string"
                      },
                      "first_name": {
                        "type": "string"
                      },
                      "last_name": {
                        "type": "string"
                      },
                      "organization_name": {
                        "type": "string"
                      },
                      "domain": {
                        "type": "string"
                      }
                    }
                  }
                },
                "reveal_personal_emails": {
                  "type": "boolean"
                },
                "reveal_phone_numbers": {
                  "type": "boolean"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bulk person enrichment result",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/organizations/enrich": {
      "post": {
        "summary": "Enrich a single organization",
        "operationId": "enrichOrganization",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Organization enrichment result",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/organizations/bulk_enrich": {
      "post": {
        "summary": "Enrich multiple organizations (up to 10)",
        "operationId": "bulkEnrichOrganizations",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "queries": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "properties": {
                      "domain": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bulk organization enrichment result",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "apolloApiKey": {
      "type": "apiKey",
      "in": "header",
      "name": "X-Api-Key",
      "x-ms-parameter-location": "header"
    }
  },
  "security": [
    {
      "apolloApiKey": []
    }
  ]
}