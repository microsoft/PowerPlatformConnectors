{
  "swagger": "2.0",
  "info": {
    "title": "apolloenrichment2",
    "description": "Power Automate custom connector for Apollo.io enrichment APIs.",
    "version": "1.0.0"
  },
  "host": "api.apollo.io",
  "basePath": "/api/v1",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/people/match": {
      "post": {
        "summary": "Enrich a single person",
        "operationId": "EnrichPerson",
        "parameters": [
          {
            "name": "X-Api-Key",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "B77T7_5ZuWuyhE5PRhxuHw",
            "description": "Hardcoded Apollo API Key"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "first_name": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                },
                "organization_name": {
                  "type": "string"
                },
                "domain": {
                  "type": "string"
                },
                "reveal_personal_emails": {
                  "type": "boolean"
                },
                "reveal_phone_numbers": {
                  "type": "boolean"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Person enrichment result",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/organizations/enrich": {
      "post": {
        "summary": "Enrich a single organization",
        "operationId": "EnrichOrganization",
        "parameters": [
          {
            "name": "X-Api-Key",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "B77T7_5ZuWuyhE5PRhxuHw",
            "description": "Hardcoded Apollo API Key"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Organization enrichment result",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}