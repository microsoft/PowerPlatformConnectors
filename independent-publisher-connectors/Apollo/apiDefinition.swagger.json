  "security": [
    {
      "api_key": []
    }
  ],
  "paths": {
    "/api/v1/people/match": {
      "post": {
        "summary": "Enrich Contact",
        "description": "Enrich a single contact with Apollo data including title, company, LinkedIn, phone numbers, and more.",
        "operationId": "EnrichContact",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["email"],
              "properties": {
                "email": {
                  "type": "string",
                  "description": "Email address of the person",
                  "x-ms-summary": "Email",
                  "x-ms-visibility": "important"
                },
                "reveal_personal_emails": {
                  "type": "boolean",
                  "description": "Retrieve personal email addresses (consumes credits)",
                  "x-ms-summary": "Reveal Personal Emails",
                  "default": false,
                  "x-ms-visibility": "advanced"
                },
                "reveal_phone_number": {
                  "type": "boolean",
                  "description": "Retrieve phone numbers (consumes credits)",
                  "x-ms-summary": "Reveal Phone Numbers",
                  "default": false,
                  "x-ms-visibility": "advanced"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful enrichment response",
            "schema": {
              "$ref": "#/definitions/PersonEnrichmentResponse"
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/people/bulk_match": {
      "post": {
        "summary": "Bulk Enrich Contacts",
        "description": "Enrich up to 10 contacts in a single API call.",
        "operationId": "BulkEnrichContacts",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["details"],
              "properties": {
                "details": {
                  "type": "array",
                  "description": "Array of contacts to enrich (max 10)",
                  "x-ms-summary": "Contacts",
                  "x-ms-visibility": "important",
                  "items": {
                    "type": "object",
                    "required": ["email"],
                    "properties": {
                      "email": {
                        "type": "string",
                        "description": "Email address",
                        "x-ms-summary": "Email"
                      }
                    }
                  }
                },
                "reveal_personal_emails": {
                  "type": "boolean",
                  "x-ms-summary": "Reveal Personal Emails",
                  "default": false,
                  "x-ms-visibility": "advanced"
                },
                "reveal_phone_number": {
                  "type": "boolean",
                  "x-ms-summary": "Reveal Phone Numbers",
                  "default": false,
                  "x-ms-visibility": "advanced"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful bulk enrichment response",
            "schema": {
              "$ref": "#/definitions/BulkPersonEnrichmentResponse"
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/organizations/enrich": {
      "get": {
        "summary": "Enrich Account",
        "description": "Enrich a single organization/account with Apollo data including industry, revenue, employee count, funding details, and technologies.",
        "operationId": "EnrichAccount",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Company domain to enrich (e.g., apollo.io)",
            "x-ms-summary": "Domain",
            "x-ms-visibility": "important"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful organization enrichment response",
            "schema": {
              "$ref": "#/definitions/OrganizationEnrichmentResponse"
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/organizations/bulk_enrich": {
      "post": {
        "summary": "Bulk Enrich Accounts",
        "description": "Enrich up to 10 organizations/accounts in a single API call.",
        "operationId": "BulkEnrichAccounts",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["domains"],
              "properties": {
                "domains": {
                  "type": "array",
                  "description": "Array of company domains to enrich (max 10)",
                  "x-ms-summary": "Domains",
                  "x-ms-visibility": "important",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful bulk organization enrichment response",
            "schema": {
              "$ref": "#/definitions/BulkOrganizationEnrichmentResponse"
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    }
  },
