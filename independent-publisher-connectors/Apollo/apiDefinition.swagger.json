{
  "swagger": "2.0",
  "info": {
    "version": "2.0.0",
    "title": "Apollo Enrichment",
    "description": "Apollo.io is a sales intelligence platform with a database of over 275 million verified B2B contacts. Enrich your contacts and accounts with company and people data including job titles, phone numbers, LinkedIn profiles, company size, revenue, and more.",
    "contact": {
      "name": "Steve Mordue",
      "url": "https://forceworks.com",
      "email": "steve@forceworks.com"
    },
    "x-ms-api-annotation": {
      "status": "Production"
    }
  },
  "x-ms-connector-metadata": [
    {
      "propertyName": "Website",
      "propertyValue": "https://forceworks.com"
    },
    {
      "propertyName": "Privacy policy",
      "propertyValue": "https://www.apollo.io/privacy-policy"
    },
    {
      "propertyName": "Categories",
      "propertyValue": "Sales and CRM;Data"
    }
  ],
  "host": "api.apollo.io",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "header",
      "name": "X-Api-Key",
      "description": "Your Apollo.io API Key"
    }
