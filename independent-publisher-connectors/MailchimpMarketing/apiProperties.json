{
  "properties": {
    "connectionParameters": {
      "api_key": {
        "type": "securestring",
        "uiDefinition": {
          "displayName": "API Key",
          "description": "Enter your Mailchimp API Key (found in Account > Extras > API Keys)",
          "tooltip": "Provide your Mailchimp API Key",
          "constraints": {
            "required": "true",
            "tabIndex": 1
          }
        }
      },
      "datacenter": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Datacenter",
          "description": "Enter your Mailchimp datacenter (e.g., us1, us2, us21). Found at the end of your API key after the dash.",
          "tooltip": "The datacenter prefix from your API key (e.g., us21)",
          "constraints": {
            "required": "true",
            "tabIndex": 2
          }
        }
      }
    },
    "iconBrandColor": "#da3b01",
    "capabilities": [],
    "policyTemplateInstances": [
      {
        "templateId": "setheader",
        "title": "Set Authorization Header",
        "parameters": {
          "x-ms-apimTemplateParameter.name": "Authorization",
          "x-ms-apimTemplateParameter.value": "Bearer @connectionParameters('api_key')",
          "x-ms-apimTemplateParameter.existsAction": "override"
        }
      },
      {
        "templateId": "routerequesttoendpoint",
        "title": "Route to Datacenter",
        "parameters": {
          "x-ms-apimTemplateParameter.newPath": "",
          "x-ms-apimTemplateParameter.httpMethod": "@Request.OriginalHTTPMethod",
          "x-ms-apimTemplateParameter.newScheme": "https",
          "x-ms-apimTemplateParameter.newHost": "@connectionParameters('datacenter').api.mailchimp.com"
        }
      }
    ],
    "publisher": "Steve Mordue",
    "stackOwner": "Mailchimp (Intuit)"
  }
}
