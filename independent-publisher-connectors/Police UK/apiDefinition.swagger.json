        "summary": "Get street-level crimes",
        "operationId": "GetStreetCrimes",
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-visibility": "important",
            "description": "Crime category slug, e.g. all-crime, burglary, robbery."
          },
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "type": "string",
            "x-ms-visibility": "important",
            "description": "Latitude of the centre point to search within a 1 mile radius e.g. 52.629729"
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "type": "string",
            "x-ms-visibility": "important",
            "description": "Longitude of the centre point to search within a 1 mile radius e.g. -1.131592"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-visibility": "important",
            "format": "",
            "description": "Month to retrieve crimes for in YYYY-MM format e.g. 2024-01. Defaults to latest available month if not provided."
          }
        ],
        "description": "Returns crimes at street-level for a given location, either within a 1 mile radius of a single point using latitude and longitude, or within a custom area using a polygon. Note that locations returned are approximations and not exact crime locations. If no date is provided the latest available month is used.",
        "x-ms-visibility": "important"
      }
