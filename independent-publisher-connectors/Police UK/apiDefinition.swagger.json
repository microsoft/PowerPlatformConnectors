          {
            "name": "force",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-visibility": "important",
            "description": "Unique force identifier e.g. leicestershire, metropolitan. Use the \"List all forces\" action to retrieve valid values."
          },
          {
            "name": "neighbourhood",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Unique neighbourhood identifier e.g. NC04.Use the \"List neighbourhoods for a force\" action to retrieve valid neighbourhood identifiers for a given force.",
