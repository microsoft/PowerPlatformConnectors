                    "description": "Matching identifier from the request"
                },
                "result": {
                    "type": "object",
                    "x-ms-summary": "Result",
                    "description": "Successful method execution result",
                    "additionalProperties": true
                },
                "error": {
                    "type": "object",
                    "x-ms-summary": "Error",
                    "description": "Error information if the request failed",
                    "properties": {
                        "code": {
