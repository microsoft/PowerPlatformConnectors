                            "description": "Error code"
                        },
                        "message": {
                            "type": "string",
                            "x-ms-summary": "Error Message",
                            "description": "Human-readable error message"
                        },
                        "data": {
                            "x-ms-summary": "Error Data",
                            "description": "Additional error information"
                        }
                    }
