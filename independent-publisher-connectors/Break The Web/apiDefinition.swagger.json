                },
                "Answer": {
                    "type": "string",
                    "x-ms-summary": "Answer",
                    "description": "Answer to the question based on available information"
                }
            }
        },
        "MCPRequest": {
            "type": "object",
            "required": [
                "jsonrpc",
                "method",
                "id"
            ],
            "properties": {
                "jsonrpc": {
                    "type": "string",
                    "enum": ["2.0"],
                    "x-ms-summary": "JSON-RPC Version",
                    "description": "JSON-RPC protocol version (must be 2.0)"
                },
                "method": {
                    "type": "string",
                    "x-ms-summary": "Method",
                    "description": "The MCP method to invoke (e.g., 'tools/call', 'tools/list', 'initialize')",
                    "enum": [
                        "initialize",
                        "tools/list", 
                        "tools/call",
                        "btw/get_trending_feed",
                        "btw/search_trends"
                    ]
                },
                "params": {
                    "type": "object",
                    "x-ms-summary": "Parameters",
                    "description": "Method-specific parameters",
                    "additionalProperties": true
                },
                "id": {
                    "type": "string",
                    "x-ms-summary": "Request ID",
                    "description": "Unique identifier for the request"
                }
            }
        },
        "MCPResponse": {
            "type": "object",
            "required": [
                "jsonrpc",
                "id"
            ],
            "properties": {
                "jsonrpc": {
                    "type": "string",
                    "enum": ["2.0"],
                    "x-ms-summary": "JSON-RPC Version",
                    "description": "JSON-RPC protocol version"
                },
                "id": {
                    "type": "string",
