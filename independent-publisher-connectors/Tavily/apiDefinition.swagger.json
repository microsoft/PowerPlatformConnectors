        "summary": "Tavily Crawl (Beta)",
        "description": "Traverse a site like a graph starting from a base URL.",
        "operationId": "CrawlPost",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "description": "The URL to crawl.",
                  "title": "URL"
                },
                "max_depth": {
                  "type": "integer",
                  "format": "int32",
                  "description": "The maximum depth to crawl.",
                  "title": "Max Depth"
                },
                "max_breadth": {
                  "type": "integer",
                  "format": "int32",
                  "description": "The maximum breadth to crawl.",
                  "title": "Max Breadth",
                  "default": 20
                },
                "limit": {
                  "type": "integer",
                  "format": "int32",
                  "description": "The maximum number of pages to crawl.",
                  "title": "Limit",
                  "default": 50
                },
                "instructions": {
                  "type": "string",
                  "description": "Instructions for the crawler.",
                  "title": "Instructions"
                },
                "select_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The paths to include in the crawl.",
                  "title": "Select Paths"
                },
                "select_domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The domains to include in the crawl.",
                  "title": "Select Domains"
                },
                "exclude_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The paths to exclude from the crawl.",
                  "title": "Exclude Paths"
                },
                "exclude_domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The domains to exclude from the crawl.",
                  "title": "Exclude Domains"
                },
                "allow_external": {
                  "type": "boolean",
                  "description": "Whether to allow external links. The connector default is false; the API default is true.",
                  "title": "Allow External",
                  "default": false
                },
                "include_images": {
                  "type": "boolean",
                  "description": "Whether to include images in the crawl.",
                  "title": "Include Images",
                  "default": false
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The categories to include in the crawl.",
                  "title": "Categories"
                },
                "extract_depth": {
                  "type": "string",
                  "description": "The depth of content extraction.",
                  "title": "Extract Depth",
                  "default": "basic",
                  "enum": [
                    "basic",
                    "advanced"
                  ]
                },
                "chunks_per_source": {
                  "type": "integer",
                  "description": "Maximum number of relevant chunks returned per source (1-5). Used with Instructions.",
                  "title": "Chunks Per Source",
                  "minimum": 1,
                  "maximum": 5
                },
                "format": {
                  "type": "string",
                  "description": "Format of the extracted content: markdown or text.",
                  "title": "Format",
                  "enum": [
                    "markdown",
                    "text"
                  ]
                },
                "include_favicon": {
                  "type": "boolean",
                  "description": "Include the favicon URL for each result.",
                  "title": "Include Favicon"
                },
                "timeout": {
                  "type": "number",
                  "description": "Maximum seconds to wait for the crawl before timing out (10-150).",
                  "title": "Timeout",
                  "format": "float",
                  "minimum": 10,
                  "maximum": 150
                },
                "include_usage": {
                  "type": "boolean",
                  "description": "Include credit usage information in the response.",
                  "title": "Include Usage"
                }
              },
              "required": [
                "url"
              ]
            }
          }
        ]
      }
    },
