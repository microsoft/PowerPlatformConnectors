{
  "swagger": "2.0",
  "info": {
    "title": "Tavily (Independent Publisher)",
    "description": "Tavily is a specialized search engine designed for Large Language Models (LLMs) and AI agents. It provides real-time, accurate, and unbiased information, enabling AI applications to retrieve and process data efficiently. Tavily is built with AI developers in mind, simplifying the process of integrating dynamic web information into AI-driven solutions.",
    "version": "1.0",
    "contact": {
      "name": "Troy Taylor",
      "url": "https://www.hitachisolutions.com",
      "email": "ttaylor@hitachisolutions.com"
    }
  },
  "host": "api.tavily.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/search": {
      "post": {
        "responses": {
          "200": {
            "description": "default",
            "schema": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "description": "The search query.",
                  "title": "Query"
                },
                "answer": {
                  "type": "string",
                  "description": "The answer to the search query.",
                  "title": "Answer"
                },
                "images": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "The URL of the image.",
                        "title": "URL"
                      },
                      "description": {
                        "type": "string",
                        "description": "A brief description of the image.",
                        "title": "Description"
                      }
                    }
                  },
                  "title": "Images"
                },
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "description": "The title of the result.",
                        "title": "Title"
                      },
                      "url": {
                        "type": "string",
                        "description": "The URL of the result.",
                        "title": "URL"
                      },
                      "content": {
                        "type": "string",
                        "description": "The content of the result.",
                        "title": "Content"
                      },
                      "score": {
                        "type": "number",
                        "format": "float",
                        "description": "The relevance score of the result.",
                        "title": "Score"
                      },
                      "raw_content": {
                        "type": "string",
                        "description": "The raw content of the result.",
                        "title": "Raw Content"
                      },
                      "published_date": {
                        "type": "string",
                        "description": "Estimated publish date of the result, returned when Include Published Date is true.",
                        "title": "Published Date"
                      },
                      "favicon": {
                        "type": "string",
                        "description": "Favicon URL of the result, returned when Include Favicon is true.",
                        "title": "Favicon"
                      }
                    }
                  },
                  "title": "Results"
                },
                "response_time": {
                  "type": "number",
                  "format": "float",
                  "description": "The time taken to process the request.",
                  "title": "Response Time"
                },
                "request_id": {
                  "type": "string",
                  "description": "Unique identifier for the request.",
                  "title": "Request ID"
                },
                "usage": {
                  "type": "object",
                  "description": "Credit usage information, returned when Include Usage is true.",
                  "title": "Usage",
                  "properties": {
                    "credits": {
                      "type": "number",
                      "format": "float",
                      "description": "Credits used by the request.",
                      "title": "Credits"
                    }
                  }
                },
                "auto_parameters": {
                  "type": "object",
                  "description": "Parameters chosen automatically when Auto Parameters is enabled.",
                  "title": "Auto Parameters"
                }
              }
            }
          }
        },
        "summary": "Tavily Search",
        "description": "Execute a search query using Tavily Search.",
        "operationId": "SearchPost",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "description": "The search query.",
                  "title": "Query"
                },
                "topic": {
                  "type": "string",
                  "description": "The topic of the search: general, news or finance.",
                  "title": "Topic",
                  "default": "general",
                  "enum": [
                    "general",
                    "news",
                    "finance"
                  ]
                },
                "search_depth": {
                  "type": "string",
                  "description": "The depth of the search. basic, advanced, fast and ultra-fast trade latency against relevance; fast and ultra-fast return lower-latency results.",
                  "title": "Search Depth",
                  "default": "basic",
                  "enum": [
                    "basic",
                    "advanced",
                    "fast",
                    "ultra-fast"
                  ]
                },
                "chunks_per_source": {
                  "type": "integer",
                  "format": "int32",
                  "description": "The number of chunks to return per source.",
                  "title": "Chunks Per Source",
                  "minimum": 1,
                  "maximum": 3
                },
                "max_results": {
                  "type": "integer",
                  "format": "int32",
                  "description": "The maximum number of results to return. The connector default is 5; the API default is 10.",
                  "title": "Max Results",
                  "default": 5,
                  "maximum": 20
                },
                "time_range": {
                  "type": "string",
                  "description": "The time range for the search.",
                  "title": "Time Range",
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year",
                    "d",
                    "w",
                    "m",
                    "y"
                  ]
                },
                "days": {
                  "type": "integer",
                  "format": "int32",
                  "description": "The number of days to include in the search.",
                  "title": "Days",
                  "default": 7
                },
                "include_answer": {
                  "type": "boolean",
                  "description": "Whether to include answers in the search results.",
                  "title": "Include Answer",
                  "default": false
                },
                "include_raw_content": {
                  "type": "boolean",
                  "description": "Whether to include raw content in the search results.",
                  "title": "Include Raw Content",
                  "default": false
                },
                "include_images": {
                  "type": "boolean",
                  "description": "Whether to include images in the search results.",
                  "title": "Include Images",
                  "default": false
                },
                "include_image_descriptions": {
                  "type": "boolean",
                  "description": "Whether to include image descriptions in the search results.",
                  "title": "Include Image Descriptions"
                },
                "include_domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "include_domains",
                  "title": "Include Domains"
                },
                "exclude_domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "exclude_domains",
                  "title": "Exclude Domains"
                },
                "start_date": {
                  "type": "string",
                  "description": "Return results published or updated after this date (YYYY-MM-DD).",
                  "title": "Start Date"
                },
                "end_date": {
                  "type": "string",
                  "description": "Return results published or updated before this date (YYYY-MM-DD).",
                  "title": "End Date"
                },
                "include_published_date": {
                  "type": "boolean",
                  "description": "Include a published_date field in each result.",
                  "title": "Include Published Date"
                },
                "filter_by_published_date": {
                  "type": "boolean",
                  "description": "Remove results whose published date falls outside the time range, start date or end date window.",
                  "title": "Filter By Published Date"
                },
                "include_favicon": {
                  "type": "boolean",
                  "description": "Include the favicon URL for each result.",
                  "title": "Include Favicon"
                },
                "include_domains_mode": {
                  "type": "string",
                  "description": "How Include Domains is applied: restrict limits results to the listed domains; prefer also allows other domains.",
                  "title": "Include Domains Mode",
                  "enum": [
                    "restrict",
                    "prefer"
                  ]
                },
                "country": {
                  "type": "string",
