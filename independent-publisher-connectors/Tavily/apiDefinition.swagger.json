                      "title": "Credits"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Tavily Extract",
        "description": "Extract web page content from one or more specified URLs using Tavily Extract.",
        "operationId": "ExtractPost",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "urls": {
                  "type": "string",
                  "description": "The URLs to extract content from.",
                  "title": "URLs"
                },
                "include_images": {
                  "type": "boolean",
                  "description": "Whether to include images in the extraction.",
                  "title": "Include Images",
                  "default": false
                },
                "extract_depth": {
                  "type": "string",
                  "description": "The depth of the extraction.",
                  "title": "Extract Depth",
                  "default": "basic",
                  "enum": [
                    "basic",
                    "advanced"
                  ]
                },
                "query": {
                  "type": "string",
                  "description": "User intent used to rerank extracted content chunks by relevance.",
                  "title": "Query"
                },
                "chunks_per_source": {
                  "type": "integer",
                  "description": "Maximum number of relevant chunks returned per source (1-5). Used with Query.",
                  "title": "Chunks Per Source",
                  "minimum": 1,
                  "maximum": 5
                },
                "format": {
                  "type": "string",
                  "description": "Format of the extracted content: markdown or text.",
                  "title": "Format",
                  "enum": [
                    "markdown",
                    "text"
                  ]
                },
                "timeout": {
                  "type": "number",
                  "description": "Maximum seconds to wait for extraction before timing out (1-60).",
                  "title": "Timeout",
                  "format": "float",
                  "minimum": 1.0,
                  "maximum": 60.0
                },
                "include_favicon": {
                  "type": "boolean",
                  "description": "Include the favicon URL for each result.",
                  "title": "Include Favicon"
                },
                "include_usage": {
                  "type": "boolean",
                  "description": "Include credit usage information in the response.",
                  "title": "Include Usage"
                }
              },
              "required": [
                "urls"
              ]
            }
          }
        ]
      }
    },
