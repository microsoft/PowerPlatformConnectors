    "/extract": {
      "post": {
        "responses": {
          "200": {
            "description": "default",
            "schema": {
              "type": "object",
              "properties": {
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "The URL of the web page.",
                        "title": "URL"
                      },
                      "raw_content": {
                        "type": "string",
                        "description": "The raw HTML content of the web page.",
                        "title": "Raw Content"
                      },
                      "images": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "The images found on the web page.",
                        "title": "Images"
                      },
                      "favicon": {
                        "type": "string",
                        "description": "Favicon URL of the result, returned when Include Favicon is true.",
                        "title": "Favicon"
                      }
                    }
                  },
                  "title": "Results"
                },
                "failed_results": {
                  "type": "array",
