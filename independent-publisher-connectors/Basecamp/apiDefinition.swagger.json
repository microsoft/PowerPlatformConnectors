              "$ref": "#/definitions/TodoItemDetail"
            }
          }
        }
      }
    },
    "/todos/{todo_id}/completion.json": {
      "post": {
        "operationId": "completeTodo",
        "summary": "Complete To-do",
        "description": "Marks a to-do item as complete.",
