            "description": "The ID of the to-do item to complete.",
            "x-ms-url-encoding": "single"
          }
        ],
        "responses": {
          "204": {
            "description": "To-do marked as complete."
          },
          "default": {
            "description": "To-do marked as complete."
          }
        }
      }
    },
