{
  "properties": {
    "connectionParameters": {
      "tenantId": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Microsoft Entra tenant ID",
          "description": "The QMFI-Research directory tenant ID.",
          "tooltip": "Format: a GUID, e.g. 885f01ab-7364-4484-be0a-231d541c9e7f",
          "constraints": {
            "required": "true"
          }
        }
      },
      "foundryResource": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Foundry resource endpoint",
          "description": "Base URL of the Azure AI Foundry resource, e.g. https://qmfi-research-project-resource.services.ai.azure.com",
          "tooltip": "No trailing slash.",
          "constraints": {
            "required": "true"
          }
        }
      },
      "projectName": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Foundry project name",
          "description": "The Foundry project that hosts the agent.",
          "constraints": {
            "required": "true"
          }
        },
        "default": "qmfi-research-project"
      },
      "agentName": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Agent name",
          "description": "The Foundry agent exposed via the connector.",
          "constraints": {
            "required": "true"
          }
        },
        "default": "NatureLM-Idun-5-MoE"
      },
      "tokenScope": {
        "type": "string",
        "uiDefinition": {
          "displayName": "OAuth scope",
          "description": "Entra resource scope for the bearer token. Must end in /.default.",
          "constraints": {
            "required": "true"
          }
        },
        "default": "https://ai.azure.com/.default"
      }
    },
    "iconBrandColor": "#0067B8",
    "capabilities": [],
    "publisher": "QMFI-Research",
    "stackOwner": "Alexander Kleine"
  }
}