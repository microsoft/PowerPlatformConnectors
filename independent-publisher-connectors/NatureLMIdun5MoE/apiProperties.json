{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "oauth2",
          "clientId": "",
          "scopes": [
            "https://ai.azure.com/.default"
          ],
          "redirectMode": "Global",
          "redirectUrl": "https://global.consent.azure-apim.net/redirect",
          "properties": {
            "IsFirstParty": "False",
            "IsOnbehalfofLoginSupported": false
          },
          "customParameters": {
            "authorizationUrl": {
              "value": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize"
            },
            "tokenUrl": {
              "value": "https://login.microsoftonline.com/common/oauth2/v2.0/token"
            },
            "refreshUrl": {
              "value": "https://login.microsoftonline.com/common/oauth2/v2.0/token"
            }
          }
        }
      },
      "foundryResource": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Foundry resource name",
          "description": "The Azure AI Foundry resource host name (without .services.ai.azure.com), e.g. contoso-resource.",
          "tooltip": "The resource that hosts your Foundry project.",
          "constraints": {
            "required": "true"
          }
        }
      },
      "projectName": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Foundry project name",
          "description": "The Foundry project that hosts the target agent.",
          "tooltip": "Project name as shown in Azure AI Foundry.",
          "constraints": {
            "required": "true"
          }
        }
      },
      "agentName": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Agent name",
          "description": "The Foundry agent exposed via this connector.",
          "tooltip": "Agent deployment name in the project.",
          "constraints": {
            "required": "true"
          }
        }
      }
    },
    "iconBrandColor": "#da3b01",
    "capabilities": [],
    "publisher": "Alexander Kleine",
    "stackOwner": "Alexander Kleine"
  }
}
