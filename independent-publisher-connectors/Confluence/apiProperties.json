{
  "properties": {
    "connectionParameters": {
      "domain": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Confluence Domain",
          "description": "Your Atlassian subdomain (e.g., mycompany from mycompany.atlassian.net).",
          "tooltip": "Enter just the subdomain part (e.g., mycompany), NOT the full URL",
          "constraints": {
            "required": "true"
          }
        }
      },
      "username": {
        "type": "securestring",
        "uiDefinition": {
          "displayName": "Email Address",
          "description": "Your Atlassian account email address.",
          "tooltip": "Enter the email address associated with your Atlassian account",
          "constraints": {
            "tabIndex": 2,
            "clearText": true,
            "required": "true"
          }
        }
      },
      "password": {
        "type": "securestring",
        "uiDefinition": {
          "displayName": "API Token",
          "description": "Your Atlassian API token.",
          "tooltip": "Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens",
          "constraints": {
            "tabIndex": 3,
            "clearText": false,
            "required": "true"
          }
        }
      }
    },
    "iconBrandColor": "#da3b01",
    "capabilities": [],
    "policyTemplateInstances": [
      {
        "templateId": "dynamichosturl",
        "title": "Set Confluence Host",
        "parameters": {
          "x-ms-apimTemplateParameter.urlTemplate": "https://@connectionParameters('domain').atlassian.net/wiki"
        }
      }
    ],
    "publisher": "Aaron Mah",
    "stackOwner": "Confluence"
  }
}