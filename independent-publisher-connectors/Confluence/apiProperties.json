{
  "properties": {
    "connectionParameters": {
      "domain": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Domain",
          "description": "Your Atlassian subdomain (e.g., 'mycompany' from mycompany.atlassian.net).",
          "tooltip": "Enter your Atlassian subdomain",
          "constraints": {
            "required": "true"
          }
        }
      },
      "username": {
        "type": "securestring",
        "uiDefinition": {
          "displayName": "Email Address",
          "description": "Your Atlassian account email address.",
          "tooltip": "Email used to log in to Atlassian",
          "constraints": {
            "tabIndex": 2,
            "clearText": true,
            "required": "true"
          }
        }
      },
      "password": {
        "type": "securestring",
        "uiDefinition": {
          "displayName": "API Token",
          "description": "API token from id.atlassian.com/manage-profile/security/api-tokens.",
          "tooltip": "Generate at Atlassian API token page",
          "constraints": {
            "tabIndex": 3,
            "clearText": false,
            "required": "true"
          }
        }
      }
    },
    "iconBrandColor": "#da3b01",
    "capabilities": [],
    "policyTemplateInstances": [
      {
        "templateId": "dynamichosturl",
        "title": "Set Confluence host",
        "parameters": {
          "x-ms-apimTemplateParameter.urlTemplate": "https://@connectionParameters('domain').atlassian.net/wiki"
        }
      }
    ],
    "publisher": "Aaron Mah",
    "stackOwner": "Atlassian Confluence"
  }
}
