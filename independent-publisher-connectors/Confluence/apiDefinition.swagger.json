            "description": "The ID of the space.",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "created-date",
              "-created-date",
              "modified-date",
              "-modified-date",
              "title",
              "-title"
            ],
            "x-ms-summary": "Sort",
            "description": "Sort order for blog posts."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "current",
              "draft",
              "trashed"
            ],
            "x-ms-summary": "Status",
            "description": "Filter by blog post status."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "x-ms-summary": "Limit",
            "description": "Maximum results per page. Default: 25."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Cursor",
            "description": "Pagination cursor.",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "body-format",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "storage",
              "atlas_doc_format"
            ],
            "x-ms-summary": "Body Format",
            "description": "Body format to return. Options: storage, atlas_doc_format."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/BlogPostList"
            }
          }
        }
      }
    },
    "/api/v2/blogposts/{blogPostId}": {
      "get": {
        "operationId": "getBlogPostById",
        "summary": "Get a blog post",
        "description": "Returns a specific Confluence blog post by its ID, including title, body content, and version info.",
        "tags": [
          "Blog Posts"
        ],
        "parameters": [
          {
            "name": "blogPostId",
            "in": "path",
            "required": true,
            "type": "integer",
