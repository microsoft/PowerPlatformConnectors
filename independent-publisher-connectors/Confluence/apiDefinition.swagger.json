            ],
            "x-ms-summary": "Body Format",
            "description": "Body format to return. Options: storage, atlas_doc_format, view."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/BlogPost"
            }
          }
        }
      }
    }
