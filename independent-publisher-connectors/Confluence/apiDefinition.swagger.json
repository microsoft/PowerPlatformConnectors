{
  "swagger": "2.0",
  "info": {
    "version": "1.0",
    "title": "Confluence",
    "description": "Confluence Cloud is Atlassian's team wiki and knowledge management platform. This connector enables reading pages, creating and updating content, posting comments, searching with CQL, and accessing blog posts.",
    "contact": {
      "name": "Aaron Mah",
      "url": "https://github.com/aaronmah",
      "email": "aa.mahh@gmail.com"
    }
  },
  "host": "aaron-mah.atlassian.net",
  "basePath": "/wiki",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v2/pages/{pageId}": {
      "get": {
        "operationId": "getPageById",
        "summary": "Get a page",
        "description": "Returns a specific Confluence page including its title, body content, version info, and links.",
        "tags": [
          "Pages"
        ],
        "parameters": [
          {
            "name": "pageId",
            "in": "path",
            "required": true,
            "type": "integer",
            "x-ms-summary": "Page ID",
            "description": "The ID of the page to retrieve.",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "body-format",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "storage",
              "atlas_doc_format",
              "view"
            ],
            "x-ms-summary": "Body Format",
            "description": "Body format to return. Options: storage, atlas_doc_format, view. If omitted, no body is returned."
          },
          {
            "name": "include-labels",
            "in": "query",
            "required": false,
            "type": "boolean",
            "x-ms-summary": "Include Labels",
            "description": "Include labels in the response. Default: false."
          },
          {
            "name": "include-properties",
            "in": "query",
            "required": false,
            "type": "boolean",
            "x-ms-summary": "Include Properties",
            "description": "Include content properties in the response. Default: false.",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "include-likes",
            "in": "query",
            "required": false,
            "type": "boolean",
            "x-ms-summary": "Include Likes",
            "description": "Include like count in the response. Default: false.",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "type": "integer",
            "x-ms-summary": "Version Number",
            "description": "Specific version number to retrieve. Default: latest.",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Page"
            }
          }
        }
      },
      "put": {
        "operationId": "updatePage",
        "summary": "Update a page",
        "description": "Updates an existing Confluence page title, body, or status. Requires the current version number incremented by 1. Call Get a page first to obtain the current version number.",
        "tags": [
          "Pages"
        ],
        "parameters": [
          {
            "name": "pageId",
            "in": "path",
            "required": true,
            "type": "integer",
            "x-ms-summary": "Page ID",
            "description": "The ID of the page to update.",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "id",
                "status",
                "title",
                "body",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "x-ms-summary": "Page ID (Body)",
                  "description": "The page ID. Must match the path parameter."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "current",
                    "draft"
                  ],
                  "x-ms-summary": "Status",
                  "description": "Page status. Options: current, draft."
                },
                "title": {
                  "type": "string",
                  "x-ms-summary": "Title",
                  "description": "The new or unchanged page title."
                },
                "body": {
                  "type": "object",
                  "required": [
                    "representation",
                    "value"
                  ],
                  "properties": {
                    "representation": {
                      "type": "string",
                      "default": "storage",
                      "x-ms-visibility": "internal",
                      "x-ms-summary": "Body Format",
                      "description": "The body content format."
                    },
                    "value": {
                      "type": "string",
                      "x-ms-summary": "Body Content",
                      "description": "The updated body content in storage format (XHTML)."
                    }
                  },
                  "description": "The page body content."
                },
                "version": {
                  "type": "object",
                  "required": [
                    "number"
                  ],
                  "properties": {
                    "number": {
                      "type": "integer",
                      "x-ms-summary": "Version Number",
                      "description": "The new version number (current version + 1)."
                    },
                    "message": {
                      "type": "string",
                      "x-ms-summary": "Version Message",
                      "description": "Optional change message for this version."
                    }
                  },
                  "description": "Version information for optimistic concurrency."
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Page"
            }
          }
        }
      }
    },
    "/api/v2/spaces": {
      "get": {
        "operationId": "getSpaces",
        "summary": "List spaces",
        "description": "Returns all Confluence spaces the authenticated user can access. Use to discover space IDs for other operations.",
        "tags": [
          "Spaces"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "global",
              "personal"
            ],
            "x-ms-summary": "Space Type",
            "description": "Filter by space type. Options: global, personal."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "current",
              "archived"
            ],
            "x-ms-summary": "Status",
            "description": "Filter by status. Options: current, archived. Default: current."
          },
          {
            "name": "keys",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Space Keys",
            "description": "Comma-separated space keys to filter by (e.g., ENG,DOCS)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "x-ms-summary": "Limit",
            "description": "Maximum results per page. Default: 25."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Cursor",
            "description": "Opaque cursor for pagination.",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "id",
              "-id",
              "key",
              "-key",
              "name",
              "-name"
            ],
            "x-ms-summary": "Sort",
            "description": "Sort order. Options: id, -id, key, -key, name, -name.",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SpaceList"
            }
          }
        }
      }
    },
    "/api/v2/pages": {
      "post": {
        "operationId": "createPage",
        "summary": "Create a page",
        "description": "Creates a new page in a Confluence space. Supports storage format (XHTML) body content.",
        "tags": [
          "Pages"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "spaceId",
                "title",
                "body"
              ],
              "properties": {
                "spaceId": {
                  "type": "string",
                  "x-ms-summary": "Space ID",
                  "description": "The ID of the space to create the page in."
                },
                "title": {
                  "type": "string",
                  "x-ms-summary": "Title",
                  "description": "The title of the new page."
                },
                "parentId": {
                  "type": "string",
                  "x-ms-summary": "Parent Page ID",
                  "description": "Parent page ID. Creates as a child page if provided."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "current",
                    "draft"
                  ],
                  "default": "current",
                  "x-ms-summary": "Status",
                  "description": "Page status. Options: current (published), draft."
                },
                "body": {
                  "type": "object",
                  "required": [
                    "representation",
                    "value"
                  ],
                  "properties": {
                    "representation": {
                      "type": "string",
                      "default": "storage",
                      "x-ms-visibility": "internal",
                      "x-ms-summary": "Body Format",
                      "description": "The body content format."
                    },
                    "value": {
                      "type": "string",
                      "x-ms-summary": "Body Content",
                      "description": "The page body content in storage format (e.g., <p>Hello world</p>)."
                    }
                  },
                  "description": "The page body content."
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Page"
            }
          }
        }
      }
    },
    "/api/v2/footer-comments": {
      "post": {
        "operationId": "createFooterComment",
        "summary": "Add a comment to a page",
        "description": "Creates a footer comment on a Confluence page. Can also reply to an existing comment by providing parentCommentId.",
        "tags": [
          "Comments"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "body"
              ],
              "properties": {
                "pageId": {
                  "type": "string",
                  "x-ms-summary": "Page ID",
                  "description": "The page to comment on. Required if blogPostId and parentCommentId are not provided."
                },
                "blogPostId": {
                  "type": "string",
                  "x-ms-summary": "Blog Post ID",
                  "description": "The blog post to comment on. Required if pageId and parentCommentId are not provided."
                },
                "parentCommentId": {
                  "type": "string",
                  "x-ms-summary": "Parent Comment ID",
                  "description": "Reply to an existing comment. Required if pageId and blogPostId are not provided."
                },
                "body": {
                  "type": "object",
                  "required": [
                    "representation",
                    "value"
                  ],
                  "properties": {
                    "representation": {
                      "type": "string",
                      "default": "storage",
                      "x-ms-visibility": "internal",
                      "x-ms-summary": "Body Format",
                      "description": "The body content format."
                    },
                    "value": {
                      "type": "string",
                      "x-ms-summary": "Comment Text",
                      "description": "The comment text in storage format (e.g., <p>Great page!</p>)."
                    }
                  },
                  "description": "The comment body content."
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/FooterComment"
            }
          }
        }
      }
    },
    "/api/v2/spaces/{spaceId}": {
      "get": {
        "operationId": "getSpaceById",
        "summary": "Get a space",
        "description": "Returns details of a specific Confluence space by its ID, including name, key, description, and homepage.",
        "tags": [
          "Spaces"
        ],
        "parameters": [
          {
            "name": "spaceId",
            "in": "path",
            "required": true,
            "type": "integer",
            "x-ms-summary": "Space ID",
            "description": "The ID of the space to retrieve.",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "description-format",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "plain",
              "view"
            ],
            "x-ms-summary": "Description Format",
            "description": "Format for the space description. Options: plain, view."
          },
          {
            "name": "include-icon",
            "in": "query",
            "required": false,
            "type": "boolean",
            "x-ms-summary": "Include Icon",
            "description": "Include space icon URL. Default: false.",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Space"
            }
          }
        }
      }
    },
    "/rest/api/search": {
      "get": {
        "operationId": "searchContent",
        "summary": "Search content",
        "description": "Searches Confluence content using Confluence Query Language (CQL). Supports full-text search, space filters, type filters, and date range queries.",
        "tags": [
          "Search"
        ],
        "parameters": [
          {
            "name": "cql",
            "in": "query",
            "required": true,
            "type": "string",
            "x-ms-summary": "CQL Query",
            "description": "Confluence Query Language expression (e.g., type=page AND space=ENG AND text~\"onboarding\")."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "x-ms-summary": "Limit",
            "description": "Maximum number of results. Default: 25."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "type": "integer",
            "x-ms-summary": "Start",
            "description": "Offset for pagination (0-based).",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "includeArchivedSpaces",
            "in": "query",
            "required": false,
            "type": "boolean",
            "x-ms-summary": "Include Archived Spaces",
            "description": "Include content from archived spaces. Default: false.",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SearchResult"
            }
          }
        }
      }
    },
    "/api/v2/spaces/{spaceId}/blogposts": {
      "get": {
        "operationId": "getBlogPostsInSpace",
