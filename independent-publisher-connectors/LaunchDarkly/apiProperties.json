    "policyTemplateInstances": [
      {
        "templateId": "setheader",
        "title": "Set Content-Type for semantic patch operations",
        "parameters": {
          "x-ms-apimTemplateParameter.name": "Content-Type",
          "x-ms-apimTemplateParameter.value": "application/json; domain-model=launchdarkly.semanticpatch",
          "x-ms-apimTemplateParameter.existsAction": "override",
          "x-ms-apimTemplate-policySection": "Request",
          "x-ms-apimTemplate-operationName": [
            "turnFlagOn",
            "turnFlagOff"
          ]
        }
      },
      {
        "templateId": "routerequesttoendpoint",
        "title": "Route turnFlagOn to PATCH flags endpoint",
        "parameters": {
          "x-ms-apimTemplateParameter.newPath": "/flags/@queryParameters('projectKey')/@queryParameters('featureFlagKey')",
          "x-ms-apimTemplateParameter.httpMethod": "PATCH",
          "x-ms-apimTemplate-operationName": [
            "turnFlagOn"
          ]
        }
      },
      {
        "templateId": "routerequesttoendpoint",
        "title": "Route turnFlagOff to PATCH flags endpoint",
        "parameters": {
          "x-ms-apimTemplateParameter.newPath": "/flags/@queryParameters('projectKey')/@queryParameters('featureFlagKey')",
          "x-ms-apimTemplateParameter.httpMethod": "PATCH",
          "x-ms-apimTemplate-operationName": [
            "turnFlagOff"
          ]
        }
      }
    ],
