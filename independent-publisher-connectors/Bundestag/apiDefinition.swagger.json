        },
        "title": {
          "type": "string",
          "example": "Protokoll der 1. Sitzung des 19. Deutschen Bundestages",
          "description": "Title of the plenary protocol."
        },
        "pdf_hash": {
          "type": "string",
          "example": "a33af31e7c4524db8db172ef8f90f6d",
          "description": "MD5 checksum of the document's PDF."
        },
        "fundstelle": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Fundstelle"
          },
          "description": "References to related legislative documents."
        }
      },
      "required": [
        "id",
        "type",
        "dokumentart",
        "dokumentnummer",
        "wahlperiode",
        "datum",
        "aktualisiert"
      ]
    },
    "AktivitaetListResponse": {
