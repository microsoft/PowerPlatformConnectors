{
  "swagger": "2.0",
  "info": {
    "title": "Fiscal Data Service",
    "description": "A collection of endpoints to retrieve machine-readable datasets from the US Treasury's Fiscal Data Service",
    "version": "1.0",
    "contact": {
      "name": "Dan Romano",
      "url": "https://developments.substack.com",
      "email": "dan.romano@swolcat.com"
    }
  },
  "host": "api.fiscaldata.treasury.gov",
  "basePath": "/services/api/fiscal_service",
  "schemes": [
    "https"
  ],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "Use 'Bearer {token}' to authenticate."
    }
  },
  "paths": {
    "/vorgang": {
      "get": {
        "summary": "Retrieve all parliamentary processes",
        "description": "Returns a list of all parliamentary processes in the Bundestag.",
        "operationId": "getVorgangList",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "format": "int32",
            "required": false,
            "description": "Maximum number of records to return.",
            "x-ms-summary": "Limit the number of returned records."
          },
          {
            "name": "cursor",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "Cursor for pagination.",
            "x-ms-summary": "Cursor used for paginated requests."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing a list of processes.",
            "schema": {
              "$ref": "#/definitions/VorgangListResponse"
            }
          },
          "400": {
            "$ref": "#/definitions/ErrorResponse"
          },
          "401": {
            "$ref": "#/definitions/ErrorResponse"
          },
          "500": {
            "$ref": "#/definitions/ErrorResponse"
          }
        }
      }
    },
    "/vorgang/{id}": {
      "get": {
        "summary": "Retrieve a specific parliamentary process",
        "description": "Returns metadata for a specific parliamentary process in the Bundestag.",
        "operationId": "getVorgangById",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The unique identifier of the parliamentary process.",
            "x-ms-summary": "Retrieve a parliamentary process by its ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing process details.",
            "schema": {
              "$ref": "#/definitions/Vorgang"
            }
          },
          "400": {
            "$ref": "#/definitions/ErrorResponse"
          },
          "401": {
            "$ref": "#/definitions/ErrorResponse"
          },
          "404": {
            "$ref": "#/definitions/ErrorResponse"
          },
          "500": {
            "$ref": "#/definitions/ErrorResponse"
          }
        }
      }
    }
  },
