  "definitions": {
    "VorgangListResponse": {
      "type": "object",
      "description": "Response containing a list of parliamentary processes.",
      "properties": {
        "numFound": {
          "type": "integer",
          "format": "int32",
          "description": "Total number of processes found.",
          "example": 176
        },
        "cursor": {
          "type": "string",
          "description": "Pagination cursor for retrieving more results.",
          "example": "AoJwgNjC_PYCMURydWNrc2FjaGUtMjQ5MjYw"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Vorgang"
          }
        }
      },
      "required": [
        "numFound",
        "documents"
      ]
    },
    "Vorgang": {
      "type": "object",
      "description": "Metadata for a specific parliamentary process.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "example": "84433",
          "description": "Unique identifier for the process."
        },
        "type": {
          "type": "string",
          "example": "Vorgang",
          "description": "Type of process."
        },
        "wahlperiode": {
          "type": "integer",
          "format": "int32",
          "example": 19,
          "description": "Legislative period."
        },
        "title": {
          "type": "string",
          "example": "Weitergeltung von Geschäftsordnungsrecht",
          "description": "Title of the process."
        },
        "datum": {
          "type": "string",
          "format": "date",
          "example": "2019-03-27",
          "description": "Date the process was created."
        },
        "aktualisiert": {
          "type": "string",
          "format": "date-time",
          "example": "2022-08-01T15:30:16+02:00",
          "description": "Last update timestamp."
        }
      },
      "required": [
        "id",
        "type",
        "wahlperiode",
        "title",
        "datum",
        "aktualisiert"
      ]
    },
    "VorgangspositionListResponse": {
      "type": "object",
      "description": "Response containing a list of parliamentary process steps.",
      "properties": {
        "numFound": {
          "type": "integer",
          "format": "int32",
          "description": "Total number of process steps found.",
          "example": 200
        },
        "cursor": {
          "type": "string",
          "description": "Pagination cursor for retrieving more results.",
          "example": "NjC_PYCMURydWNrc2FjaGUtMjQ5MjYw"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Vorgangsposition"
          }
        }
      },
      "required": [
        "numFound",
        "documents"
      ]
    },
    "Vorgangsposition": {
      "type": "object",
      "description": "Metadata for a specific parliamentary process step.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "example": "173376",
          "description": "Unique identifier for the process step."
        },
        "type": {
          "type": "string",
          "example": "Antrag zur Weitergeltung der Geschäftsordnung",
          "description": "Type of process step."
        },
        "datum": {
          "type": "string",
          "format": "date",
          "example": "2022-08-01",
          "description": "Date of the process step."
        },
        "aktualisiert": {
          "type": "string",
          "format": "date-time",
          "example": "2022-08-01T15:30:16+02:00",
          "description": "Last update timestamp."
        },
        "gang": {
          "type": "boolean",
          "example": true,
          "description": "Indicates whether the process step is crucial for legislative progress."
        },
        "fundstelle": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Fundstelle"
          },
          "description": "References to related legislative documents."
        }
      },
      "required": [
        "id",
        "type",
        "datum",
        "aktualisiert"
      ]
    },
    "Fundstelle": {
      "type": "object",
      "description": "Reference to a document related to the process step.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the reference."
        },
        "dokumentart": {
          "type": "string",
          "description": "Type of referenced document."
        },
        "datum": {
          "type": "string",
          "format": "date",
          "description": "Date of the referenced document."
        },
        "pdf_url": {
          "type": "string",
          "description": "URL to the document PDF."
        }
      },
      "required": [
        "id",
        "dokumentart",
        "datum"
      ]
    },
    "DrucksacheListResponse": {
      "type": "object",
      "description": "Response containing a list of parliamentary documents.",
      "properties": {
        "numFound": {
          "type": "integer",
          "format": "int32",
          "description": "Total number of documents found.",
          "example": 300
        },
        "cursor": {
          "type": "string",
          "description": "Pagination cursor for retrieving more results.",
          "example": "MjQ5MjYwNjC_PYCMURydWNrc2FjaGU"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Drucksache"
          }
        }
      },
      "required": [
        "numFound",
        "documents"
      ]
    },
    "Drucksache": {
      "type": "object",
      "description": "Metadata for a specific parliamentary document.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "example": "68852",
          "description": "Unique identifier for the document."
        },
        "type": {
          "type": "string",
          "example": "Drucksache",
          "description": "Type of document."
        },
        "dokumentart": {
          "type": "string",
          "example": "Antrag",
          "description": "Document category."
        },
        "dokumentnummer": {
          "type": "string",
          "example": "19/1",
          "description": "Document number."
        },
        "wahlperiode": {
          "type": "integer",
          "format": "int32",
          "example": 19,
          "description": "Legislative period."
        },
        "herausgeber": {
          "type": "string",
          "example": "BT",
          "description": "Issuer of the document."
        },
        "datum": {
          "type": "string",
          "format": "date",
          "example": "2017-10-24",
          "description": "Date the document was issued."
        },
        "aktualisiert": {
          "type": "string",
          "format": "date-time",
          "example": "2022-08-01T15:30:16+02:00",
          "description": "Last update timestamp."
        },
        "title": {
          "type": "string",
          "example": "Weitergeltung von Geschäftsordnungsrecht",
          "description": "Title of the document."
        },
        "pdf_hash": {
          "type": "string",
          "example": "a33af31e7c4524db8db172ef8f90f6d",
          "description": "MD5 checksum of the document's PDF."
        },
        "fundstelle": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Fundstelle"
          },
          "description": "References to related legislative documents."
        }
      },
      "required": [
        "id",
        "type",
        "dokumentart",
        "dokumentnummer",
        "wahlperiode",
        "datum",
        "aktualisiert"
      ]
    },
    "PlenarprotokollListResponse": {
      "type": "object",
