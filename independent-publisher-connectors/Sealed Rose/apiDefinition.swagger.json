{
  "swagger": "2.0",
  "info": {
    "title": "Sealed Rose",
    "contact": {
      "name": "Derek Gallardo",
      "url": "https://sealedrose.com/verify-video",
      "email": "derek@sealedrose.com"
    },
    "description": "Sealed Rose is an AI media forensics and deepfake detection platform providing multimodal neural verification across video, audio, image, and text to detect synthetic face swaps, AI voice clones, and generative media artifacts.",
    "version": "1.0"
  },
  "host": "sealedrose.com",
  "basePath": "/api/v1",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/detect/text": {
      "post": {
        "summary": "Detect AI-generated text",
        "description": "Analyzes text content for perplexity, burstiness, and token-distribution signatures of large language models.",
        "operationId": "DetectText",
        "x-ms-visibility": "important",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "The text verification payload.",
            "schema": {
              "$ref": "#/definitions/TextDetectionRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ForensicAnalysisResponse"
            }
          }
        }
      }
    },
    "/detect/url": {
      "post": {
        "summary": "Verify media URL for deepfake manipulation",
        "description": "Evaluates a remote video, audio, or image URL using multimodal neural decomposition and temporal optical flow analysis.",
        "operationId": "VerifyMediaUrl",
        "x-ms-visibility": "important",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "The remote media URL verification payload.",
            "schema": {
              "$ref": "#/definitions/MediaUrlDetectionRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ForensicAnalysisResponse"
            }
          }
        }
      }
    },
    "/usage": {
      "get": {
        "summary": "Get API quota and usage",
        "description": "Returns the current billing period verification usage and remaining API quota for the authenticated key.",
        "operationId": "GetUsage",
        "x-ms-visibility": "important",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/UsageResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TextDetectionRequest": {
      "type": "object",
      "description": "Request payload for text forensic verification.",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "title": "Text Content",
          "description": "The text passage to evaluate for synthetic AI generation."
        }
      }
    },
    "MediaUrlDetectionRequest": {
      "type": "object",
      "description": "Request payload for remote media URL forensic verification.",
      "required": [
        "media_url"
      ],
      "properties": {
        "media_url": {
          "type": "string",
          "title": "Media URL",
          "description": "Direct HTTPS URL to the video, audio, or image file to inspect."
        },
        "modality": {
          "type": "string",
          "title": "Modality",
          "description": "Media modality to analyze (video, audio, or image).",
          "enum": [
            "video",
            "audio",
            "image"
          ],
          "default": "video"
        }
      }
    },
    "ForensicAnalysisResponse": {
      "type": "object",
      "description": "Forensic analysis report returned by Sealed Rose.",
      "properties": {
        "verdict": {
          "type": "string",
          "title": "Verdict",
          "description": "Classification verdict (authentic, synthetic, or inconclusive)."
        },
        "synthetic_probability": {
          "type": "number",
          "format": "double",
          "title": "Synthetic Probability",
          "description": "Probability score from 0.0 (authentic) to 1.0 (synthetic)."
        },
        "confidence": {
          "type": "string",
          "title": "Confidence",
          "description": "Confidence band (high, medium, or low)."
        },
        "inspection_url": {
          "type": "string",
          "title": "Inspection URL",
          "description": "Interactive forensic report link on https://sealedrose.com/verify-video."
        }
      }
    },
    "UsageResponse": {
      "type": "object",
      "description": "API quota and usage summary.",
      "properties": {
        "plan": {
          "type": "string",
          "title": "Plan",
          "description": "Active API subscription tier."
        },
        "used": {
          "type": "integer",
          "format": "int32",
          "title": "Checks Used",
          "description": "Number of forensic verifications performed in the current period."
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "title": "Quota Limit",
          "description": "Total forensic verifications included in the current period."
        }
      }
    }
  },
  "parameters": {},
  "responses": {},
  "securityDefinitions": {
    "API Key": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization"
    }
  },
  "security": [
    {
      "API Key": []
    }
  ],
  "tags": [],
  "x-ms-connector-metadata": [
    {
      "propertyName": "Website",
      "propertyValue": "https://sealedrose.com/verify-video"
    },
    {
      "propertyName": "Privacy policy",
      "propertyValue": "https://sealedrose.com/privacy"
    },
    {
      "propertyName": "Categories",
      "propertyValue": "AI;Security"
    }
  ]
}
