    "/fillform": {
      "post": {
        "summary": "Fill Form",
        "description": "Fills form fields in a PDF from a list of Field/Value pairs. Supports text, checkbox, radio, dropdown and list box fields. Run Get Form Fields first to discover the field names and their valid Options.",
        "operationId": "FillPdfForm",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "description": "Base64-encoded PDF and the field values to fill.",
            "schema": {
              "type": "object",
              "required": [
                "PdfFileContent",
                "Fields"
              ],
              "properties": {
                "PdfFileContent": {
                  "type": "string",
                  "format": "byte",
                  "title": "PDF File Content",
                  "description": "Base64-encoded PDF content",
                  "x-ms-summary": "PDF File Content"
                },
                "Fields": {
                  "type": "array",
                  "title": "Fields",
                  "description": "The fields to fill. Add one item per field; get the field names from Get Form Fields.",
                  "x-ms-summary": "Fields",
                  "items": {
                    "type": "object",
                    "required": [
                      "Field",
                      "Value"
                    ],
                    "properties": {
                      "Field": {
                        "type": "string",
                        "title": "Field",
                        "description": "The field name (as returned by Get Form Fields)",
                        "x-ms-summary": "Field"
                      },
                      "Value": {
                        "type": "string",
                        "title": "Value",
                        "description": "The value to set. Text: the text. Checkbox: true/false. Radio, dropdown or list box: one of the field's Options from Get Form Fields.",
                        "x-ms-summary": "Value"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The PDF with the form fields filled in",
            "schema": {
              "type": "object",
              "properties": {
                "FilledPdf": {
                  "type": "string",
                  "format": "byte",
                  "title": "Filled PDF",
                  "description": "Base64-encoded PDF with the form fields filled in",
                  "x-ms-summary": "Filled PDF"
                },
                "FieldsApplied": {
                  "type": "array",
                  "title": "Fields Applied",
                  "description": "The field names that were found and filled",
                  "x-ms-summary": "Fields Applied",
                  "items": {
                    "type": "string"
                  }
                },
                "FieldsNotFound": {
                  "type": "array",
                  "title": "Fields Not Found",
                  "description": "Requested field names that do not exist in the PDF",
                  "x-ms-summary": "Fields Not Found",
                  "items": {
                    "type": "string"
                  }
                },
                "FieldsSkipped": {
                  "type": "array",
                  "title": "Fields Skipped",
                  "description": "Requested fields that were not written: either an unfillable type (button/signature) or a value that was not valid for the field (e.g. a dropdown value that is not one of its options).",
                  "x-ms-summary": "Fields Skipped",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid input",
            "schema": {
              "type": "object",
              "properties": {
                "Error": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "schema": {
              "type": "object",
              "properties": {
                "Error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
