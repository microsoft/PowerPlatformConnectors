    "/webtopdf": {
      "post": {
        "summary": "Convert Web Page or HTML to PDF",
        "description": "Renders a web page URL or raw HTML content to a PDF file using Cloudflare Browser Rendering. Returns a base64-encoded PDF.",
        "operationId": "ConvertWebToPdf",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "description": "URL or HTML content to render as PDF, plus optional PDF layout options.",
            "schema": {
              "type": "object",
              "properties": {
                "Url": {
                  "type": "string",
                  "title": "URL",
                  "description": "The full URL of the web page to convert to PDF. Either Url or HtmlContent must be provided.",
                  "x-ms-summary": "URL"
                },
                "HtmlContent": {
                  "type": "string",
                  "title": "HTML Content",
                  "description": "Raw HTML string to render and convert to PDF. Either Url or HtmlContent must be provided.",
                  "x-ms-summary": "HTML Content"
                },
                "Landscape": {
                  "type": "boolean",
                  "title": "Landscape",
                  "description": "Set to true to render the PDF in landscape orientation. Defaults to portrait.",
                  "x-ms-summary": "Landscape",
                  "x-ms-visibility": "advanced"
                },
                "PrintBackground": {
                  "type": "boolean",
                  "title": "Print Background",
                  "description": "Set to true to include background colours and images in the PDF.",
                  "x-ms-summary": "Print Background",
                  "x-ms-visibility": "advanced"
                },
                "Scale": {
                  "type": "number",
                  "title": "Scale",
                  "description": "Page scale factor for the PDF, between 0.1 and 2. Defaults to 1.",
                  "x-ms-summary": "Scale",
                  "x-ms-visibility": "advanced"
                },
                "Format": {
                  "type": "string",
                  "title": "Paper Size",
                  "description": "Paper size for the generated PDF (e.g. A4, Letter). If not specified, the rendering service default (Letter) is used.",
                  "x-ms-summary": "Paper Size",
