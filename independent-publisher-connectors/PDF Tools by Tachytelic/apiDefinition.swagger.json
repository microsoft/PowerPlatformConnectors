                }
              }
            }
          }
        }
      }
    },
    "/getformfields": {
      "post": {
        "summary": "Get Form Fields",
        "description": "Lists the fillable form (AcroForm) fields in a PDF, including each field's name, type and current value. Use this before Fill Form to discover the field names.",
        "operationId": "GetPdfFormFields",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
