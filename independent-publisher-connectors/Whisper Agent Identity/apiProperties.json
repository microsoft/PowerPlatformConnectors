          "constraints": {
            "tabIndex": 1,
            "clearText": false,
            "required": "false"
          }
        }
      }
    },
    "iconBrandColor": "#7a40ff",
    "capabilities": [],
    "policyTemplateInstances": [
      {
        "templateId": "dynamichosturl",
