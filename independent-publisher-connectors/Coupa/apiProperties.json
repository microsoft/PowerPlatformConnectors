{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "oauth2generic",
          "clientId": "",
          "scopes": [],
          "redirectMode": "Global",
          "redirectUrl": "https://global.consent.azure-apim.net/redirect",
          "properties": {
            "IsFirstParty": "False",
            "IsOnbehalfofLoginSupported": false
          },
          "customParameters": {
            "authorizationUrlTemplate": {
              "value": "https://{customHost}.coupahost.com/oauth2/authorizations/new"
            },
            "authorizationUrlQueryStringTemplate": {
              "value": "?client_id={CoupaClientId}&response_type=code&redirect_uri={redirectUrl}&scope={scope}&state={State}"
            },
            "tokenUrlTemplate": {
              "value": "https://{customHost}.coupahost.com/oauth2/token"
            },
            "refreshUrlTemplate": {
              "value": "https://{customHost}.coupahost.com/oauth2/token"
            },
            "tokenBodyTemplate": {
              "value": "grant_type=authorization_code&code={code}&redirect_uri={redirectUrl}&client_id={CoupaClientId}&client_secret={CoupaClientSecret}&scope={scope}"
            },
            "refreshBodyTemplate": {
              "value": "grant_type=refresh_token&refresh_token={refreshToken}&client_id={CoupaClientId}&client_secret={CoupaClientSecret}&scope={scope}"
            }
          }
        }
      },
      "token:customHost": {
        "type": "string",
        "uiDefinition": {
          "constraints": {
            "tabIndex": 2,
            "required": "true"
          },
          "description": "Coupa instance subdomain only - e.g. mycompany-test (exclude .coupahost.com)",
          "displayName": "Coupa Instance Name",
          "tooltip": "e.g. mycompany-test"
        }
      },
      "token:scope": {
        "type": "string",
        "uiDefinition": {
          "constraints": {
            "tabIndex": 3,
            "required": "true"
          },
          "description": "Space-separated OAuth2 scopes e.g. core.purchase_order.read core.invoice.read",
          "displayName": "Coupa OAuth Scopes",
          "tooltip": "Space-separated, no commas"
        }
      },
      "token:CoupaClientId": {
        "type": "string",
        "uiDefinition": {
          "constraints": {
            "tabIndex": 4,
            "required": "true"
          },
          "description": "OAuth2 Client ID from Coupa Setup > OAuth2/OpenID Connect Clients",
          "displayName": "Coupa Client ID",
          "tooltip": "OAuth2 Client ID"
        }
      },
      "token:CoupaClientSecret": {
        "type": "securestring",
        "uiDefinition": {
          "constraints": {
            "tabIndex": 5,
            "required": "true"
          },
          "description": "OAuth2 Client Secret from Coupa - stored securely",
          "displayName": "Coupa Client Secret",
          "tooltip": "Stored securely, never shown after saving"
        }
      }
    },
    "iconBrandColor": "#da3b01",
    "capabilities": [
      "actions"
    ],
    "policyTemplateInstances": [
      {
        "templateId": "dynamichosturl",
        "title": "Set Coupa host from connection parameter",
        "parameters": {
          "x-ms-apimTemplateParameter.urlTemplate": "https://@connectionParameters('token:customHost').coupahost.com/api"
        }
      },
      {
        "templateId": "setheader",
        "title": "Accept: application/json",
        "parameters": {
          "x-ms-apimTemplateParameter.name": "Accept",
          "x-ms-apimTemplateParameter.value": "application/json",
          "x-ms-apimTemplateParameter.existsAction": "override",
          "x-ms-apimTemplate-policySection": "Request"
        }
      }
    ],
    "publisher": "NovaGL",
    "stackOwner": "Coupa Software"
  }
}