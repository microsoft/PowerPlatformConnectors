{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "oauth2",
          "clientId": "wavelength-powerplatform",
          "scopes": [
            "flows"
          ],
          "redirectMode": "GlobalPerConnector",
          "redirectUrl": "https://global.consent.azure-apim.net/redirect",
          "properties": {
            "IsFirstParty": "False"
          },
          "customParameters": {
            "AuthorizationUrl": {
              "value": "https://mcp.wavelengthflow.com/authorize"
            },
            "TokenUrl": {
              "value": "https://mcp.wavelengthflow.com/token"
            },
            "RefreshUrl": {
              "value": "https://mcp.wavelengthflow.com/token"
            }
          }
        },
        "uiDefinition": {
          "displayName": "Sign in with your Wavelength account",
          "description": "Sign in with your Wavelength account.",
          "tooltip": "Provide your Wavelength sign-in.",
          "constraints": {
            "required": "true"
          }
        }
      }
    },
    "iconBrandColor": "#F6F3EE",
    "capabilities": [
      "actions",
      "triggers"
    ],
    "scriptOperations": [
      "ListFlows",
      "CreateFlowFromText",
      "SearchFlows",
      "GetFlow",
      "ExportFlow",
      "SummarizeFlow",
      "SendFlowToChannel",
      "ListChannels",
      "ListFolders",
      "OnFlowChanged"
    ],
    "policyTemplateInstances": [],
    "publisher": "MVR Capital Holdings LLC",
    "stackOwner": "MVR Capital Holdings LLC"
  }
}
