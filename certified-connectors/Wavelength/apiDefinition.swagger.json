{
  "swagger": "2.0",
  "info": {
    "title": "Wavelength",
    "version": "1.0",
    "description": "Wavelength turns call transcripts, meeting notes, and process descriptions into editable process flow diagrams. Create flows from text, find and read flows, export and summarize flows, post flows to chat channels, and start an automation when a flow changes.",
    "contact": {
      "name": "Wavelength support",
      "url": "https://wavelengthflow.com",
      "email": "support@wavelengthflow.com"
    }
  },
  "host": "wavelengthflow.com",
  "basePath": "/api",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/flows": {
      "get": {
        "operationId": "ListFlows",
        "summary": "List flows",
        "description": "Lists the saved flows of the signed-in user, with the most recent change first.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Title contains",
            "description": "Text to match in the flow title. The match ignores case.",
            "x-ms-visibility": "important"
          },
          {
            "name": "folder_id",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Folder",
            "description": "The folder to list flows from.",
            "x-ms-visibility": "advanced",
            "x-ms-dynamic-values": {
              "operationId": "ListFolders",
              "value-collection": "folders",
              "value-path": "id",
              "value-title": "name"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "x-ms-summary": "Maximum count",
            "description": "The maximum number of flows to return, from 1 to 100.",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "The request was successful.",
            "schema": {
              "$ref": "#/definitions/FlowList"
            }
          },
          "400": {
            "description": "The request was not valid or the tool returned an error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "The access token is not valid or expired."
          }
        }
      },
      "post": {
        "operationId": "CreateFlowFromText",
        "summary": "Create a flow from text",
        "description": "Creates and saves a process flow from a transcript, call notes, or a description of a process.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "x-ms-summary": "Text",
                  "description": "The transcript, call notes, or process description to turn into a flow.",
                  "x-ms-visibility": "important"
                },
                "title": {
                  "type": "string",
                  "x-ms-summary": "Title",
                  "description": "The title of the flow. If you leave it empty, the first line of the text becomes the title.",
                  "x-ms-visibility": "important"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "vertical",
                    "horizontal"
                  ],
                  "default": "vertical",
                  "x-ms-summary": "Layout direction",
                  "description": "The layout direction. Vertical goes from top to bottom. Horizontal goes from left to right.",
                  "x-ms-visibility": "advanced"
                },
                "folder_id": {
                  "type": "string",
                  "x-ms-summary": "Folder",
                  "description": "The folder to save the flow in.",
                  "x-ms-visibility": "advanced",
                  "x-ms-dynamic-values": {
                    "operationId": "ListFolders",
                    "value-collection": "folders",
                    "value-path": "id",
                    "value-title": "name"
                  }
                },
                "team_id": {
                  "type": "string",
                  "x-ms-summary": "Team ID",
                  "description": "The ID of the team to assign the flow to.",
                  "x-ms-visibility": "advanced"
                },
                "org_id": {
                  "type": "string",
                  "x-ms-summary": "Organization ID",
                  "description": "The ID of the organization to save the flow in.",
                  "x-ms-visibility": "advanced"
                }
              }
            },
            "description": "The text to turn into a flow, and an optional title."
          }
        ],
        "responses": {
          "200": {
            "description": "The request was successful.",
            "schema": {
              "$ref": "#/definitions/CreatedFlow"
            }
          },
          "400": {
            "description": "The request was not valid or the tool returned an error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "The access token is not valid or expired."
          }
        }
      }
    },
    "/search/flows": {
      "get": {
        "operationId": "SearchFlows",
        "summary": "Search flows",
        "description": "Searches the saved flows of the signed-in user by title, step labels, and transcript text.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "type": "string",
            "x-ms-summary": "Search text",
            "description": "The text to search for. Use at least 2 characters.",
            "x-ms-visibility": "important"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 20,
            "minimum": 1,
            "maximum": 50,
            "x-ms-summary": "Maximum count",
            "description": "The maximum number of matches to return, from 1 to 50.",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "The request was successful.",
            "schema": {
              "$ref": "#/definitions/SearchResult"
            }
          },
          "400": {
            "description": "The request was not valid or the tool returned an error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "The access token is not valid or expired."
          }
        }
      }
    },
    "/flows/{flow_id}": {
      "get": {
        "operationId": "GetFlow",
        "summary": "Get a flow",
        "description": "Gets the steps, links, Mermaid diagram, and open link of one saved flow.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "flow_id",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Flow ID",
            "description": "The ID of the flow.",
            "x-ms-visibility": "important",
            "x-ms-url-encoding": "single",
            "x-ms-dynamic-values": {
              "operationId": "ListFlows",
              "parameters": {
                "limit": {
                  "value": 100
                }
              },
              "value-collection": "flows",
              "value-path": "id",
              "value-title": "title"
            }
          },
          {
            "name": "include_transcript",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-ms-summary": "Include transcript",
            "description": "Set to Yes to include the full transcript in the result.",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "The request was successful.",
            "schema": {
              "$ref": "#/definitions/FlowDetail"
            }
          },
          "400": {
            "description": "The request was not valid or the tool returned an error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "The access token is not valid or expired."
          }
        }
      }
    },
    "/flows/{flow_id}/export": {
      "get": {
        "operationId": "ExportFlow",
        "summary": "Export a flow",
        "description": "Exports one saved flow as Mermaid, SVG, draw.io XML, or JSON text.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "flow_id",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Flow ID",
            "description": "The ID of the flow.",
            "x-ms-visibility": "important",
            "x-ms-url-encoding": "single",
            "x-ms-dynamic-values": {
              "operationId": "ListFlows",
              "parameters": {
                "limit": {
                  "value": 100
                }
              },
              "value-collection": "flows",
              "value-path": "id",
              "value-title": "title"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "type": "string",
            "enum": [
              "mermaid",
              "svg",
              "drawio",
              "json"
            ],
            "default": "mermaid",
            "x-ms-summary": "Export format",
            "description": "The export format.",
            "x-ms-visibility": "important"
          }
        ],
        "responses": {
          "200": {
            "description": "The request was successful.",
            "schema": {
              "$ref": "#/definitions/ExportResult"
            }
          },
          "400": {
            "description": "The request was not valid or the tool returned an error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "The access token is not valid or expired."
          }
        }
      }
    },
    "/flows/{flow_id}/summary": {
      "get": {
        "operationId": "SummarizeFlow",
        "summary": "Summarize a flow",
        "description": "Writes a recap email, a statement of work outline, or a list of systems in scope from one saved flow.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "flow_id",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Flow ID",
            "description": "The ID of the flow.",
            "x-ms-visibility": "important",
            "x-ms-url-encoding": "single",
            "x-ms-dynamic-values": {
              "operationId": "ListFlows",
              "parameters": {
                "limit": {
                  "value": 100
                }
              },
              "value-collection": "flows",
              "value-path": "id",
              "value-title": "title"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "type": "string",
            "enum": [
              "recap_email",
              "sow_outline",
              "systems_in_scope"
            ],
            "default": "systems_in_scope",
            "x-ms-summary": "Summary format",
            "description": "The summary format. The systems_in_scope format does not use AI.",
            "x-ms-visibility": "important"
          },
          {
            "name": "audience",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Audience",
            "description": "The reader of the recap email or the outline, for example the client CFO.",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "The request was successful.",
            "schema": {
              "$ref": "#/definitions/SummaryResult"
            }
          },
          "400": {
            "description": "The request was not valid or the tool returned an error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "The access token is not valid or expired."
          }
        }
      }
    },
    "/flows/{flow_id}/send": {
      "post": {
        "operationId": "SendFlowToChannel",
        "summary": "Send a flow to a channel",
        "description": "Posts a flow summary and link to a Slack, Microsoft Teams, Google Chat, or Discord channel, or to a webhook that the user set up.",
        "x-ms-visibility": "advanced",
        "parameters": [
          {
            "name": "flow_id",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Flow ID",
            "description": "The ID of the flow.",
            "x-ms-visibility": "important",
            "x-ms-url-encoding": "single",
            "x-ms-dynamic-values": {
              "operationId": "ListFlows",
              "parameters": {
                "limit": {
                  "value": 100
                }
              },
              "value-collection": "flows",
              "value-path": "id",
              "value-title": "title"
            }
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "channel_id"
              ],
              "properties": {
                "channel_id": {
                  "type": "string",
                  "x-ms-summary": "Channel",
                  "description": "The channel to post to.",
                  "x-ms-visibility": "important",
                  "x-ms-dynamic-values": {
                    "operationId": "ListChannels",
                    "value-collection": "channels",
                    "value-path": "channel_id",
                    "value-title": "label"
                  }
                },
                "summary_lines": {
                  "type": "array",
                  "maxItems": 15,
                  "items": {
                    "type": "string"
                  },
                  "x-ms-summary": "Summary lines",
                  "description": "The summary lines to send in place of the default summary. You can send up to 15 lines.",
                  "x-ms-visibility": "advanced"
                }
              }
            },
            "description": "The channel to post to, and the summary lines to include."
          }
        ],
        "responses": {
          "200": {
            "description": "The request was successful.",
            "schema": {
              "$ref": "#/definitions/SendResult"
            }
          },
          "400": {
            "description": "The request was not valid or the tool returned an error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "The access token is not valid or expired."
          }
        }
      }
    },
    "/channels": {
      "get": {
        "operationId": "ListChannels",
        "summary": "List channels",
        "description": "Lists the chat channels and webhooks that the user set up.",
        "x-ms-visibility": "internal",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request was successful.",
            "schema": {
              "$ref": "#/definitions/ChannelList"
            }
          },
          "400": {
            "description": "The request was not valid or the tool returned an error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "The access token is not valid or expired."
          }
        }
      }
    },
    "/folders": {
      "get": {
        "operationId": "ListFolders",
        "summary": "List folders",
        "description": "Lists the folders of the signed-in user.",
        "x-ms-visibility": "internal",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request was successful.",
            "schema": {
              "$ref": "#/definitions/FolderList"
            }
          },
          "400": {
            "description": "The request was not valid or the tool returned an error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "The access token is not valid or expired."
          }
        }
      }
    },
    "/trigger/flows": {
      "get": {
        "operationId": "OnFlowChanged",
        "summary": "When a flow is created or updated",
        "description": "Starts when a flow is created or changed. The trigger checks for changes at a fixed interval.",
        "x-ms-visibility": "important",
        "x-ms-trigger": "batch",
        "x-ms-trigger-hint": "To see it work, create or edit a flow in the app.",
        "parameters": [
          {
            "name": "folder_id",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Folder",
            "description": "Only start for flows in this folder.",
            "x-ms-visibility": "advanced",
            "x-ms-dynamic-values": {
              "operationId": "ListFolders",
              "value-collection": "folders",
              "value-path": "id",
              "value-title": "name"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Changed after",
            "description": "The trigger state. The trigger sets this value.",
            "x-ms-visibility": "internal"
          }
        ],
        "responses": {
          "200": {
            "description": "One or more flows changed.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FlowListItem"
              }
            }
          },
          "202": {
            "description": "No flows changed since the last check."
          },
          "401": {
            "description": "The access token is not valid or expired."
          }
        }
      }
    }
  },
