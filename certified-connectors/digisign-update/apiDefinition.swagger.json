    "/api/envelopes/{envelopeId}": {
      "put": {
        "summary": "Update Envelope",
        "description": "Updates properties of a draft envelope. Note: the 'sender' field cannot be modified after creation.",
        "operationId": "updateEnvelope",
        "parameters": [
          {
            "name": "envelopeId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "UUID of the envelope to update",
            "x-ms-summary": "Envelope ID",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "x-ms-summary": "Name",
                  "description": "Descriptive name of the envelope",
                  "maxLength": 255,
                  "example": "Investment Term Sheet - Series A - Updated"
                },
                "emailBody": {
                  "type": "string",
                  "x-ms-summary": "Email Body",
                  "description": "Email message body sent to recipients",
                  "maxLength": 4096,
                  "example": "Please review and sign the updated final version of the Investment Term Sheet."
                },
                "emailBodyCompleted": {
                  "type": "string",
                  "x-ms-summary": "Email Body Completed",
                  "description": "Email message body sent to recipients when envelope is completed",
                  "maxLength": 4096,
                  "example": "The Investment Term Sheet has been successfully executed by all parties."
                },
                "senderName": {
                  "type": "string",
                  "x-ms-summary": "Sender Name",
                  "description": "Display name of the sender",
                  "maxLength": 255,
                  "example": "Frankfurt Capital Backoffice"
                },
                "senderEmail": {
                  "type": "string",
                  "x-ms-summary": "Sender Email",
                  "description": "Email address of the sender",
                  "maxLength": 255,
                  "example": "backoffice@frankfurt-advisory.com"
                },
                "expiration": {
                  "type": "integer",
                  "format": "int32",
                  "x-ms-summary": "Expiration",
                  "description": "Envelope expiration in days (0-365)",
                  "minimum": 0,
                  "maximum": 365,
                  "example": 30
                },
                "metadata": {
                  "type": "string",
                  "x-ms-summary": "Metadata",
                  "description": "Custom metadata string for the envelope",
                  "maxLength": 4096,
                  "example": "updated_sales_q2"
                }
              },
              "example": {
                "name": "Investment Term Sheet - Series A - Updated",
                "emailBody": "Please review and sign the updated final version of the Investment Term Sheet.",
                "emailBodyCompleted": "The Investment Term Sheet has been successfully executed by all parties.",
                "senderName": "Frankfurt Capital Backoffice",
                "senderEmail": "backoffice@frankfurt-advisory.com",
                "expiration": 30,
                "metadata": "updated_sales_q2"
              }
            },
            "description": "Request Body",
            "x-ms-body-example": {
              "name": "Investment Term Sheet - Series A - Updated",
              "emailBody": "Please review and sign the updated final version of the Investment Term Sheet.",
              "senderName": "Frankfurt Capital Backoffice",
              "expiration": 30,
              "metadata": "updated_sales_q2"
            },
            "x-ms-summary": "Parameters"
          },
          {
            "name": "x-environment",
            "in": "header",
            "required": false,
            "type": "string",
            "default": "https://api.digisign.org",
            "x-ms-visibility": "advanced",
            "description": "Target Environment URL",
            "x-ms-summary": "X Environment"
          }
        ],
        "responses": {
          "200": {
            "description": "Envelope updated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters or request body."
          },
          "401": {
            "description": "Unauthorized - Missing or invalid credentials."
          },
          "403": {
            "description": "Forbidden - Access denied."
          },
          "404": {
            "description": "Not Found - The requested resource was not found."
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server."
          }
        },
        "tags": [
          "Envelopes"
        ]
      }
    },
    "/api/envelopes/{envelopeId}/documents/{documentId}": {
      "put": {
        "summary": "Update Document",
        "description": "Updates properties of a document linked to an envelope (name, position, metadata).",
        "operationId": "updateDocument",
        "parameters": [
          {
            "name": "envelopeId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "UUID of the envelope",
            "x-ms-summary": "Envelope ID",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "UUID of the document to update",
            "x-ms-summary": "Document ID",
            "x-ms-url-encoding": "single"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "x-ms-summary": "Name",
                  "description": "Display name of the document in the envelope",
                  "example": "Frankfurt_Partners_Investment_Agreement_v2.pdf"
                },
                 "position": {
                  "type": "integer",
                  "format": "int32",
                  "x-ms-summary": "Position",
                  "description": "Document ordering position (1-based index)",
                  "example": 1
                },
                "metadata": {
                  "type": "string",
                  "x-ms-summary": "Metadata",
                  "description": "Custom metadata for the document",
                  "example": "updated_investment_doc"
                },
                "labelPositioning": {
                  "type": "string",
                  "enum": [
                    "none",
                    "top_center",
                    "top_left",
                    "top_right",
                    "bottom_left",
                    "bottom_right",
                    "bottom_center"
                  ],
                  "default": "none",
                  "x-ms-summary": "Label Positioning",
                  "description": "Positioning of the signature label."
                },
                "labelPositionX": {
                  "type": "integer",
