              "example": {
                "name": "Frankfurt_Partners_Investment_Agreement_v2.pdf",
                "position": 1,
                "metadata": "updated_investment_doc",
                "labelPositioning": "none",
                "labelPositionX": 0,
                "labelPositionY": 0
              }
            },
            "description": "Request Body",
            "x-ms-body-example": {
              "name": "Frankfurt_Partners_Investment_Agreement_v2.pdf",
              "position": 1,
              "metadata": "updated_investment_doc"
            },
            "x-ms-summary": "Parameters"
          },
          {
            "name": "x-environment",
            "in": "header",
