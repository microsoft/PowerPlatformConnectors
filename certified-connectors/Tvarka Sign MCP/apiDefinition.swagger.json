{
  "swagger": "2.0",
  "info": {
    "title": "Tvarka Sign MCP",
    "description": "Let your agent send documents for signature. Tvarka Sign emails each signer, who signs with a simple e-signature or a qualified eID signature. The agent drafts a contract from text, sends it, follows each signer, sends reminders and returns the signed PDF with its evidence package. Every signature is made by a person.",
    "version": "1.0.0",
    "contact": {
      "name": "Tvarka",
      "url": "https://tvarka.eu/",
      "email": "info@tvarka.eu"
    }
  },
  "host": "sign-api.tvarka.eu",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "header",
      "name": "X-Api-Key"
    }
  },
  "security": [
    {
      "api_key": []
    }
  ],
  "paths": {
    "/mcp": {
      "post": {
        "operationId": "InvokeMCP",
        "summary": "Tvarka Sign MCP server",
        "description": "Streamable HTTP endpoint of the Tvarka Sign MCP server. The agent uses it to send documents for signature, follow signings and download signed documents.",
        "x-ms-agentic-protocol": "mcp-streamable-1.0",
        "x-ms-visibility": "advanced",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "application/json, text/event-stream",
            "x-ms-visibility": "internal",
            "x-ms-summary": "Accept",
            "description": "The media types the MCP client accepts."
          }
        ],
        "responses": {
          "200": {
            "description": "MCP Streamable HTTP response.",
            "schema": {
              "type": "object"
            }
          },
          "202": {
            "description": "Notification accepted."
          },
          "400": {
            "description": "Bad request."
          },
          "401": {
            "description": "Unauthorized. The API key is missing or invalid."
          },
          "402": {
            "description": "Payment required. The workspace has no funds for this action."
          },
          "429": {
            "description": "Too many requests."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "x-ms-connector-metadata": [
    {
      "propertyName": "Website",
      "propertyValue": "https://tvarka.eu/"
    },
    {
      "propertyName": "Privacy policy",
      "propertyValue": "https://tvarka.eu/privacy/"
    },
    {
      "propertyName": "Categories",
      "propertyValue": "Productivity;Content and Files"
    }
  ],
  "tags": [
    {
      "name": "Tvarka Sign MCP"
    }
  ]
}
