            "description": "Page number of the collection."
          },
          {
            "name": "itemsPerPage",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 30,
            "x-ms-summary": "Items Per Page",
            "description": "Number of envelopes to return per page."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Status",
            "description": "Filter envelopes by status (e.g. draft, sent, completed, cancelled)."
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Name",
            "description": "Filter envelopes by partial name match."
          },
          {
            "name": "metadata",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Metadata",
            "description": "Filter envelopes by custom metadata value."
          },
          {
            "name": "x-environment",
            "in": "header",
            "required": false,
            "type": "string",
            "default": "https://api.digisign.org",
            "x-ms-visibility": "advanced",
            "description": "Target Environment URL",
            "x-ms-summary": "X Environment"
          }
        ],
        "responses": {
          "200": {
            "description": "List of envelopes returned successfully",
            "schema": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "x-ms-summary": "Items",
                  "description": "List of envelopes",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
