{
  "swagger": "2.0",
  "info": {
    "title": "DigiSign - List",
    "description": "Custom connector for the Digisign REST API focused on envelope and document retrieval. Allows exchanging credentials for a token, listing envelopes, retrieving envelope, document, recipient, and signature tag details, downloading signed envelopes/documents, listing users, viewing account details, and making restricted universal API calls (GET).",
    "version": "1.0.0",
    "contact": {
      "name": "DigiSign podpora",
      "email": "podpora@digisign.cz",
      "url": "https://www.digisign.cz/"
    }
  },
  "host": "api.digisign.org",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "x-ms-connection-parameters": {
    "username": {
      "type": "securestring",
      "uiDefinition": {
        "displayName": "Access Key (accessKey)",
        "description": "API Access Key from Digisign",
        "tooltip": "Enter your Digisign accessKey"
      },
      "constraints": {
        "required": "true"
      }
    },
    "password": {
      "type": "securestring",
      "uiDefinition": {
        "displayName": "Secret Key (secretKey)",
        "description": "API Secret Key from Digisign",
        "tooltip": "Enter your Digisign secretKey",
        "uiControl": "password"
      },
      "constraints": {
        "required": "true"
      }
    },
    "environment": {
      "type": "string",
      "uiDefinition": {
        "displayName": "Environment URL",
        "description": "Base URL of the Digisign API.",
        "tooltip": "Select Staging or Production, or enter a custom URL",
        "constraints": {
          "required": "true",
          "allowedValues": [
            {
              "text": "Production (https://api.digisign.org)",
              "value": "https://api.digisign.org"
            },
            {
              "text": "Staging (https://api.staging.digisign.org)",
              "value": "https://api.staging.digisign.org"
            }
          ]
        }
      }
    }
  },
  "securityDefinitions": {
    "basicAuth": {
      "type": "basic",
      "description": "Username = accessKey, Password = secretKey"
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "x-code": {
    "className": "CustomConnectorCode",
    "methodName": "PreRequest"
  },
  "paths": {
    "/api/auth-token": {
      "post": {
        "summary": "Exchange Keys for Bearer Token",
        "description": "Exchanges your API accessKey and secretKey for a short-lived Bearer token to authorize subsequent requests.",
        "operationId": "authToken",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "accessKey": {
                  "type": "string",
                  "x-ms-summary": "Access Key",
                  "description": "API Access Key from Digisign",
                  "example": "019ee470-a0c2-72a9-a666-9ced47485a9b"
                },
                "secretKey": {
                  "type": "string",
                  "x-ms-summary": "Secret Key",
                  "description": "API Secret Key from Digisign",
                  "example": "c76a5bf4d284a0c8b3e8ee9fbc5a01d3"
                }
              },
              "required": [
                "accessKey",
                "secretKey"
              ],
              "example": {
                "accessKey": "019ee470-a0c2-72a9-a666-9ced47485a9b",
                "secretKey": "c76a5bf4d284a0c8b3e8ee9fbc5a01d3"
              }
            },
            "description": "Request Body",
            "x-ms-body-example": {
              "accessKey": "019ee470-a0c2-72a9-a666-9ced47485a9b",
              "secretKey": "c76a5bf4d284a0c8b3e8ee9fbc5a01d3"
            },
            "x-ms-summary": "Parameters"
          },
          {
            "name": "x-environment",
            "in": "header",
            "required": false,
            "type": "string",
            "default": "https://api.digisign.org",
            "x-ms-visibility": "advanced",
            "description": "Target Environment URL",
            "x-ms-summary": "X Environment"
          }
        ],
        "responses": {
          "200": {
            "description": "Token returned",
            "schema": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string"
                },
                "expiresIn": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters or request body."
          },
          "401": {
            "description": "Unauthorized - Missing or invalid credentials."
          },
          "403": {
            "description": "Forbidden - Access denied."
          },
          "404": {
            "description": "Not Found - The requested resource was not found."
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server."
          }
