{
  "swagger": "2.0",
  "info": {
    "title": "Datacircle",
    "description": "Benchmarks of every GTM API: who is best for each API and plan, with each plan's score out of 100. Free, no key. Learn more at https://datacircle.dev.",
    "version": "1.0",
    "contact": {
      "name": "Datacircle",
      "url": "https://datacircle.dev/support"
    }
  },
  "x-ms-connector-metadata": [
    {
      "propertyName": "Website",
      "propertyValue": "https://datacircle.dev"
    },
    {
      "propertyName": "Privacy policy",
      "propertyValue": "https://datacircle.dev/privacy"
    },
    {
      "propertyName": "Categories",
      "propertyValue": "Data"
    }
  ],
  "host": "api.datacircle.dev",
  "basePath": "/v1",
  "schemes": [
    "https"
  ],
  "consumes": [],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/apis": {
      "get": {
        "operationId": "ListApis",
        "summary": "List the APIs",
        "description": "Every API on the sheet, with its slug, how many plans and providers it has, and its best plan.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The APIs",
            "schema": {
              "type": "object"
            }
          },
          "429": {
            "description": "More than 60 calls in a minute from one address."
          }
        }
      }
    },
    "/apis/{slug}/best": {
      "get": {
        "operationId": "GetBestPlans",
        "summary": "Who is best for an API",
        "description": "The API's plans, best first by score, each with its rank.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The API's slug, as List the APIs gives it.",
            "x-ms-summary": "API slug"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 50,
            "description": "How many plans to give, 1 to 50.",
            "x-ms-summary": "Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "The API's plans, best first",
            "schema": {
              "type": "object"
            }
          },
          "429": {
            "description": "More than 60 calls in a minute from one address."
          }
        }
      }
    },
    "/plans": {
      "get": {
        "operationId": "ListPlans",
        "summary": "List the plans",
        "description": "Plans of every API, best first, each with its score out of 100 and its price.",
        "parameters": [
          {
            "name": "api",
            "in": "query",
            "type": "string",
            "description": "The API's name or slug. Every API when left out.",
            "x-ms-summary": "API"
          },
          {
            "name": "query",
            "in": "query",
            "type": "string",
            "description": "Words that must all appear in the provider's or plan's name.",
            "x-ms-summary": "Search"
          },
          {
            "name": "sort",
            "in": "query",
            "type": "string",
            "enum": [
              "score",
              "provider",
              "price"
            ],
            "default": "score",
            "description": "score, provider or price.",
            "x-ms-summary": "Sort"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 50,
            "description": "How many plans to give, 1 to 50.",
            "x-ms-summary": "Limit"
          },
          {
            "name": "offset",
            "in": "query",
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "description": "How many found plans to skip first.",
            "x-ms-summary": "Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "The plans",
            "schema": {
              "type": "object"
            }
          },
          "429": {
            "description": "More than 60 calls in a minute from one address."
          }
        }
      }
    },
    "/providers/{slug}": {
      "get": {
        "operationId": "GetProvider",
        "summary": "Get a provider",
        "description": "One provider's plans and scores.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The provider's slug, as Bright Data's bright-data.",
            "x-ms-summary": "Provider slug"
          }
        ],
        "responses": {
          "200": {
            "description": "The provider",
            "schema": {
              "type": "object"
            }
          },
          "429": {
            "description": "More than 60 calls in a minute from one address."
          }
        }
      }
    }
  },
  "securityDefinitions": {}
}