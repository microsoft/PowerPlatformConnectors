{
  "swagger": "2.0",
  "info": {
    "title": "Quorum MCP",
    "description": "Quorum MCP gives your agents access to Quorum's public policy data: bills, regulations, votes, officials, committees and events, plus the other records your Quorum license covers. Agents can count and list records, find one by name, read and quote what a bill or regulation says, and see how bills moved over a period. Access follows the signed-in user's own Quorum permissions.",
    "version": "1.0.0",
    "contact": {
      "name": "Quorum Support",
      "url": "https://www.quorum.us/",
      "email": "support@quorum.us"
    }
  },
  "host": "quorum-mcp-external.quorum.us",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/mcp": {
      "post": {
        "operationId": "InvokeServer",
        "summary": "Invoke Quorum MCP",
        "description": "Invokes the Quorum MCP endpoint.",
        "responses": {
          "200": {
            "description": "Successful response.",
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "400": {
            "description": "Bad request.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "oauth2_auth": [
              "read"
            ]
          }
        ],
        "x-ms-agentic-protocol": "mcp-streamable-1.0"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "description": "Error message."
        }
      }
    }
  },
  "securityDefinitions": {
    "oauth2_auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://www.quorum.us/o/authorize/",
      "tokenUrl": "https://www.quorum.us/o/token/",
      "scopes": {
        "read": "Read access to Quorum MCP"
      }
    }
  },
  "security": [
    {
      "oauth2_auth": [
        "read"
      ]
    }
  ],
  "x-ms-connector-metadata": [
    {
      "propertyName": "Website",
      "propertyValue": "https://www.quorum.us/"
    },
    {
      "propertyName": "Privacy policy",
      "propertyValue": "https://www.quorum.us/privacy-policy/"
    },
    {
      "propertyName": "API License Agreement",
      "propertyValue": "https://www.quorum.us/global-terms"
    },
    {
      "propertyName": "Categories",
      "propertyValue": "AI;Data"
    }
  ]
}
