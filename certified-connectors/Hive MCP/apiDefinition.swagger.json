{
  "swagger": "2.0",
  "info": {
    "title": "Hive MCP",
    "description": "Hive is an AI-native project management and collaboration platform. Connect your agents to Hive via Model Context Protocol to search and manage projects, actions, subactions, goals, notes, messages, timesheets, files, and workspace data under the signed-in user's permissions.",
    "version": "1.0.0",
    "contact": {
      "name": "Hive Support",
      "url": "https://help.hive.com/en/",
      "email": "help@hive.com"
    }
  },
  "host": "hive-mind.hive.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/mcp": {
      "post": {
        "operationId": "InvokeServer",
        "summary": "Invoke Hive MCP",
        "description": "Invokes the Hive Model Context Protocol Streamable HTTP endpoint for dynamic tool discovery and execution.",
        "x-ms-visibility": "advanced",
        "responses": {
          "200": {
            "description": "Successful MCP Streamable HTTP response."
          },
          "400": {
            "description": "Bad request."
          },
          "401": {
            "description": "Unauthorized. Re-authenticate with Hive OAuth 2.0."
          },
          "500": {
            "description": "Server error."
          }
        },
        "security": [
          {
            "oauth2_auth": [
              "mcp:read",
              "mcp:write"
            ]
          }
        ],
        "x-ms-agentic-protocol": "mcp-streamable-1.0"
      }
    }
  },
  "securityDefinitions": {
    "oauth2_auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://auth.hive.com/mcp-as/authorize",
      "tokenUrl": "https://auth.hive.com/mcp-as/token",
      "scopes": {
        "mcp:read": "Read access to Hive workspaces, projects, actions, notes, goals, and messages",
        "mcp:write": "Create and update projects, actions, notes, goals, comments, and workspace records in Hive"
      }
    }
  },
  "security": [
    {
      "oauth2_auth": [
        "mcp:read",
        "mcp:write"
      ]
    }
  ],
  "x-ms-connector-metadata": [
    {
      "propertyName": "Website",
      "propertyValue": "https://hive.com/"
    },
    {
      "propertyName": "Privacy policy",
      "propertyValue": "https://hive.com/policy-documents/privacy-policy"
    },
    {
      "propertyName": "Terms of Service",
      "propertyValue": "https://hive.com/policy-documents/terms-of-service"
    },
    {
      "propertyName": "Categories",
      "propertyValue": "AI;Productivity"
    }
  ]
}
