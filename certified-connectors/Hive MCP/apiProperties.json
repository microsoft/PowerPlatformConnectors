{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "oauth2generic",
          "clientId": "REPLACE_WITH_CLIENT_ID",
          "scopes": [
            "mcp:read",
            "mcp:write"
          ],
          "redirectMode": "Global",
          "redirectUrl": "https://global.consent.azure-apim.net/redirect",
          "properties": {
            "IsFirstParty": "False",
            "IsOnbehalfofLoginSupported": false
          },
          "customParameters": {
            "authorizationUrlTemplate": {
              "value": "https://auth.hive.com/mcp-as/authorize"
            },
            "authorizationUrlQueryStringTemplate": {
              "value": "?resource=https%3A%2F%2Fhive-mind.hive.com%2Fmcp&client_id={ClientId}&response_type=code&redirect_uri={RedirectUrl}&scope={Scopes}&state={State}&code_challenge={CodeChallenge}&code_challenge_method=S256"
            },
            "tokenUrlTemplate": {
              "value": "https://auth.hive.com/mcp-as/token"
            },
            "tokenBodyTemplate": {
              "value": "resource=https%3A%2F%2Fhive-mind.hive.com%2Fmcp&client_id={ClientId}&client_secret={ClientSecret}&grant_type=authorization_code&code={Code}&redirect_uri={RedirectUrl}&code_verifier={CodeVerifier}"
            },
            "refreshUrlTemplate": {
              "value": "https://auth.hive.com/mcp-as/token"
            },
            "refreshBodyTemplate": {
              "value": "resource=https%3A%2F%2Fhive-mind.hive.com%2Fmcp&client_id={ClientId}&client_secret={ClientSecret}&grant_type=refresh_token&refresh_token={RefreshToken}"
            }
          }
        },
        "uiDefinition": {
          "displayName": "Hive OAuth Connection",
          "description": "Sign in with your Hive account to grant access to the Hive MCP server.",
          "tooltip": "Sign in with your Hive account.",
          "constraints": {
            "required": "true",
            "hidden": "false"
          }
        }
      }
    },
    "iconBrandColor": "#FFA561",
    "capabilities": [],
    "policyTemplateInstances": [],
    "publisher": "Hive Technology, Inc.",
    "stackOwner": "Hive Technology, Inc."
  }
}
