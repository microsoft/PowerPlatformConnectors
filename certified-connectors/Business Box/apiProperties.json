{
  "properties": {
    "connectionParameters": {
      "api_key": {
        "type": "securestring",
        "uiDefinition": {
          "displayName": "API key",
          "description": "Your Business Box API key, created in Business Box under Settings, Integrations, API keys. Paste only the key, which starts with bbk_. The connector adds the Bearer prefix.",
          "tooltip": "Paste your Business Box API key",
          "constraints": {
            "tabIndex": 2,
            "clearText": false,
            "required": "true"
          }
        }
      }
    },
    "iconBrandColor": "#171717",
    "capabilities": [
      "actions",
      "triggers"
    ],
    "policyTemplateInstances": [
      {
        "templateId": "setheader",
        "title": "Send the API key as a bearer token",
        "parameters": {
          "x-ms-apimTemplateParameter.name": "Authorization",
          "x-ms-apimTemplateParameter.value": "Bearer @connectionParameters('api_key')",
          "x-ms-apimTemplateParameter.existsAction": "override",
          "x-ms-apimTemplate-policySection": "Request"
        }
      }
    ],
    "publisher": "App Dev Plus G.K.",
    "stackOwner": "App Dev Plus G.K."
  }
}
