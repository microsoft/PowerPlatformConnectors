        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Webhook subscription created successfully."
          },
          "201": {
            "description": "Webhook subscription created successfully."
          },
          "default": {
            "description": "Operation failed."
          }
        },
        "summary": "When a leave request is created",
        "description": "Triggers when any employee in your organization submits a new leave or absence request. Use this to start approval workflows, send notifications, or update external calendars.",
        "operationId": "TriggerRequestCreatedV2",
        "x-ms-trigger": "single",
        "x-ms-visibility": "important",
        "tags": ["Triggers"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "title": "Webhook URL",
                  "description": "The callback URL where absentify will send notifications.",
                  "x-ms-visibility": "internal",
                  "x-ms-notification-url": true
                }
              },
              "required": ["url"]
            }
          }
        ]
      }
    },
