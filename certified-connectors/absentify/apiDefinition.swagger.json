  "definitions": {
    "RequestWebhookPayloadV2": {
      "type": "object",
      "title": "Request Webhook Payload",
      "description": "Webhook payload containing leave request data.",
      "properties": {
        "event_type": {
          "type": "string",
          "title": "Event Type",
          "description": "The type of event that triggered this webhook.",
          "x-ms-summary": "Event Type",
          "enum": ["request_created", "request_status_changed"]
        },
        "body": {
          "$ref": "#/definitions/RequestBodyV2"
        }
      }
    },
    "RequestBodyV2": {
      "type": "object",
      "title": "Request Body",
      "description": "The leave request details.",
      "properties": {
        "id": {
          "type": "string",
          "title": "Request ID",
          "description": "Unique identifier of the leave request.",
          "x-ms-summary": "Request ID"
        },
        "createdAt": {
          "type": "string",
          "title": "Created At",
          "description": "Timestamp when the request was created.",
          "x-ms-summary": "Created At"
        },
        "updatedAt": {
          "type": "string",
          "title": "Updated At",
          "description": "Timestamp when the request was last updated.",
          "x-ms-summary": "Updated At"
        },
        "start": {
          "type": "string",
          "title": "Start Date",
          "description": "Start date of the leave request.",
          "x-ms-summary": "Start Date"
        },
        "start_at": {
          "type": "string",
          "title": "Start Time",
          "description": "Time of day when the leave starts.",
          "x-ms-summary": "Start Time",
          "enum": ["morning", "afternoon"]
        },
        "end": {
          "type": "string",
          "title": "End Date",
          "description": "End date of the leave request.",
          "x-ms-summary": "End Date"
        },
        "end_at": {
          "type": "string",
          "title": "End Time",
          "description": "Time of day when the leave ends.",
          "x-ms-summary": "End Time",
          "enum": ["lunchtime", "end_of_day"]
        },
        "leave_unit": {
          "type": "string",
          "title": "Leave Unit",
          "description": "Unit used for measuring the leave duration.",
          "x-ms-summary": "Leave Unit",
          "enum": ["days", "hours"]
        },
        "status": {
          "type": "string",
          "title": "Status",
          "description": "Current status of the leave request.",
          "x-ms-summary": "Status",
          "enum": ["PENDING", "APPROVED", "DECLINED", "CANCELED"]
        },
        "reason": {
          "type": "string",
          "title": "Reason",
          "description": "Reason provided for the leave request.",
          "x-ms-summary": "Reason"
        },
        "approval_process": {
          "type": "string",
          "title": "Approval Process",
          "description": "Type of approval process for this request.",
          "x-ms-summary": "Approval Process",
          "enum": ["ONE_APPROVAL", "ALL_APPROVAL", "AUTOMATIC"]
        },
        "cancel_reason": {
          "type": "string",
          "title": "Cancel Reason",
          "description": "Reason for cancellation if the request was canceled.",
          "x-ms-summary": "Cancel Reason"
        },
        "canceld_date": {
          "type": "string",
          "title": "Canceled Date",
          "description": "Date when the request was canceled.",
          "x-ms-summary": "Canceled Date"
        },
        "canceld_by_member": {
          "$ref": "#/definitions/MemberReference"
        },
        "workday_absence_duration": {
          "type": "number",
          "format": "float",
          "title": "Workday Duration",
          "description": "Duration of absence in workdays.",
          "x-ms-summary": "Workday Duration"
        },
        "duration": {
          "type": "number",
          "format": "float",
          "title": "Total Duration",
          "description": "Total duration of the leave request.",
          "x-ms-summary": "Total Duration"
        },
        "take_from_allowance": {
          "type": "boolean",
          "title": "Take From Allowance",
          "description": "Whether this leave is deducted from the allowance.",
          "x-ms-summary": "Take From Allowance"
        },
        "request_creator_member": {
          "$ref": "#/definitions/MemberReference"
        },
        "requester_member": {
          "$ref": "#/definitions/MemberReference"
        },
        "leave_type": {
          "$ref": "#/definitions/LeaveTypeV2"
        },
        "allowance_type": {
          "$ref": "#/definitions/AllowanceTypeV2"
        },
        "request_approvers": {
          "type": "array",
          "title": "Request Approvers",
          "description": "List of approvers for this request.",
          "items": {
            "$ref": "#/definitions/RequestApproverV2"
          }
        }
      }
    },
