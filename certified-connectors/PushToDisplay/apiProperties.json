{
  "properties": {
    "connectionParameters": {
      "api_key": {
        "type": "securestring",
        "uiDefinition": {
          "displayName": "API Key",
          "description": "Your PushToDisplay API key (starts with pt_). Generate one in the PushToDisplay web portal under API Keys, or from the Quick Start screen in the mobile app.",
          "tooltip": "API key from the PushToDisplay web portal",
          "constraints": {
            "required": "true"
          }
        }
      }
    },
    "connectionParameterSets": {
      "uiDefinition": {
        "displayName": "Authentication Type",
        "description": "Type of authentication to be used."
      },
      "values": [
        {
          "name": "api-key",
          "uiDefinition": {
            "displayName": "API Key",
            "description": "Connect using a PushToDisplay API key (push token) generated in the web portal."
          },
          "metadata": {
            "allowSharing": true
          },
          "parameters": {
            "api_key": {
              "type": "securestring",
              "uiDefinition": {
                "displayName": "API Key",
                "description": "Your PushToDisplay API key (starts with pt_). Generate one in the PushToDisplay web portal under API Keys, or from the Quick Start screen in the mobile app. Sent as the X-Api-Key header.",
                "tooltip": "API key from the PushToDisplay web portal",
                "constraints": {
                  "required": "true"
                }
              }
            }
          }
        },
        {
          "name": "oauth2",
          "uiDefinition": {
            "displayName": "PushToDisplay account (OAuth2)",
            "description": "Sign in with your PushToDisplay account."
          },
          "metadata": {
            "allowSharing": true
          },
          "parameters": {
            "token": {
              "type": "oauthSetting",
              "oAuthSettings": {
                "identityProvider": "oauth2",
                "clientId": "<<OAuth client ID registered with the PushToDisplay IdP>>",
                "scopes": [
                  "openid",
                  "push",
                  "management"
                ],
                "redirectMode": "GlobalPerConnector",
                "customParameters": {
                  "authorizationUrl": {
                    "value": "https://idp.pushtodisplay.com/oauth/v1.0/authorize"
                  },
                  "tokenUrl": {
                    "value": "https://idp.pushtodisplay.com/oauth/v1.0/token"
                  },
                  "refreshUrl": {
                    "value": "https://idp.pushtodisplay.com/oauth/v1.0/token"
                  }
                }
              },
              "uiDefinition": null
            }
          }
        }
      ]
    },
    "iconBrandColor": "#1A2332",
    "capabilities": [
      "actions"
